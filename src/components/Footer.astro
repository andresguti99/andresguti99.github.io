---
import { getCollection } from 'astro:content';
import { TELEFONO_OFICINA, CELULAR_VENTAS, CORREO_VENTAS, FACEBOOK_UREPPSA, enlaceTelefono } from '../lib/contacto';
const anio = new Date().getFullYear();
const ciudades = (await getCollection('ciudades')).sort((a, b) =>
  a.data.nombre.localeCompare(b.data.nombre)
);
---

<footer class="pie" id="contacto">
  <div class="contenedor pie-interno">
    <div>
      <p class="pie-marca">UREPPSA</p>
      <p class="pie-lema">Cada vivienda, un compromiso.</p>
      <!-- <address>: marca la dirección como el dato de contacto del negocio,
           una señal clara para el SEO local -->
      <address class="pie-texto">
        Casa Mata #300, Col. Chapultepec Sur,<br />
        C.P. 58260, Morelia, Michoacán
      </address>
    </div>
    <div>
      <h3>Contacto</h3>
      <p class="pie-texto">
        Teléfono: <a href={enlaceTelefono(TELEFONO_OFICINA)}>{TELEFONO_OFICINA}</a><br />
        Celular: <a href={enlaceTelefono(CELULAR_VENTAS)}>{CELULAR_VENTAS}</a><br />
        Correo: <a href={`mailto:${CORREO_VENTAS}`}>{CORREO_VENTAS}</a>
      </p>
    </div>
    <div>
      <h3>Casas por ciudad</h3>
      <p class="pie-texto">
        {ciudades.map((c) => (
          <>
            <a href={`/casas-en-venta/${c.id}/`}>{c.data.nombre}</a>
            <br />
          </>
        ))}
      </p>
    </div>
    <div>
      <h3>Síguenos</h3>
      <p class="pie-texto">
        <a href={FACEBOOK_UREPPSA} target="_blank" rel="noopener noreferrer">Facebook</a><br />
        <a href="/financiamiento/">Financiamiento</a><br />
        <a href="/aviso-de-privacidad/">Aviso de Privacidad</a>
      </p>
    </div>
  </div>
  <div class="contenedor pie-legal">
    <p>© {anio} UREPPSA. Todos los derechos reservados.</p>
    <p>
      Las imágenes mostradas en este sitio son de carácter ilustrativo; las características y
      acabados finales pueden variar. Consulta los detalles vigentes con nuestro equipo de ventas.
    </p>
  </div>
</footer>

<style>
  .pie {
    /* Carbón fijo (como la barra de navegación): no cambia con esquema */
    background: var(--carbon);
    color: #e9e2d6;
    padding-block: 3rem 1.5rem;
    margin-top: 4rem;
  }

  .pie-interno {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
  }

  .pie-marca {
    font-family: var(--titulos);
    font-weight: 800;
    font-size: 1.5rem;
    margin-bottom: 0.2rem;
    color: var(--blanco);
  }

  .pie-lema {
    color: var(--amarillo);
    font-family: var(--titulos);
    font-weight: 700;
  }

  .pie h3 {
    font-size: 1rem;
    color: var(--blanco);
    margin-bottom: 0.6rem;
  }

  .pie-texto {
    font-size: 0.95rem;
    line-height: 1.9;
    font-style: normal; /* <address> viene en cursiva por defecto */
  }

  .pie a {
    color: #e9e2d6;
    text-decoration-color: rgba(233, 226, 214, 0.4);
  }

  .pie a:hover {
    color: var(--blanco);
  }

  .pie-legal {
    border-top: 1px solid rgba(233, 226, 214, 0.15);
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    font-size: 0.85rem;
    color: rgba(233, 226, 214, 0.7);
  }
</style>
