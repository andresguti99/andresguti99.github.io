  width={tamano}
  height={tamano}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M12 3a9 9 0 0 0-7.6 13.8L3 21l4.4-1.3A9 9 0 1 0 12 3Z" />
  <path d="M8.7 9.2c.4-1 1-1 1.4-.2l.5 1c.2.4.1.8-.2 1.1l-.4.4c.5 1.2 1.4 2.1 2.6 2.6l.4-.4c.3-.3.7-.4 1-.2l1 .5c.9.4.9 1 0 1.5-2.9 1.4-7-2.7-5.6-5.6.1-.3.2-.5.3-.7Z" fill="currentColor" stroke="none" />
</svg>
