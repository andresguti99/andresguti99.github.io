---
/**
 * ⚠️ SOLO PARA PRUEBAS DE DISEÑO — quitar de Base.astro antes del lanzamiento.
 * Barra flotante para cambiar de paleta y alternar el modo oscuro al vuelo.
 * La elección se guarda en localStorage para navegar el sitio completo con ella.
 */
import Icono from './Icono.astro';

const paletas = [
  { id: 'actual', nombre: 'Actual', primario: '#2f7d3b', acento: '#d96c47' },
  { id: 'clasica', nombre: 'Clásica', primario: '#0d6efd', acento: '#dc3545' },
  { id: 'oceano', nombre: 'Océano', primario: '#14608a', acento: '#e2725b' },
  { id: 'bosque', nombre: 'Bosque', primario: '#226249', acento: '#b98a2f' },
  { id: 'atardecer', nombre: 'Atardecer', primario: '#c05b33', acento: '#a83968' },
];
---

<div class="selector" role="group" aria-label="Probar paletas de color (herramienta interna)">
  {paletas.map((p) => (
    <button
      class="muestra"
      data-paleta-boton={p.id}
      title={p.nombre}
      aria-label={`Paleta ${p.nombre}`}
      style={`--muestra-a: ${p.primario}; --muestra-b: ${p.acento};`}
    ></button>
  ))}
  <span class="divisor" aria-hidden="true"></span>
  <button class="esquema" data-esquema-boton title="Alternar modo oscuro" aria-label="Alternar modo oscuro">
    <span class="icono-luna"><Icono nombre="moon-stars-fill" tamano={17} /></span>
    <span class="icono-sol"><Icono nombre="sun-fill" tamano={17} /></span>
  </button>
</div>

<script>
  const raiz = document.documentElement;
  const botones = [...document.querySelectorAll<HTMLButtonElement>('[data-paleta-boton]')];

  const marcarActiva = () => {
    const activa = raiz.dataset.paleta ?? 'actual';
    botones.forEach((boton) => boton.classList.toggle('activa', boton.dataset.paletaBoton === activa));
  };

  botones.forEach((boton) =>
    boton.addEventListener('click', () => {
      const paleta = boton.dataset.paletaBoton!;
      if (paleta === 'actual') {
        delete raiz.dataset.paleta;
        localStorage.removeItem('paleta-prueba');
      } else {
        raiz.dataset.paleta = paleta;
        localStorage.setItem('paleta-prueba', paleta);
      }
      marcarActiva();
    })
  );

  document.querySelector('[data-esquema-boton]')?.addEventListener('click', () => {
    if (raiz.dataset.esquema === 'oscuro') {
      delete raiz.dataset.esquema;
      localStorage.removeItem('esquema-prueba');
    } else {
      raiz.dataset.esquema = 'oscuro';
      localStorage.setItem('esquema-prueba', 'oscuro');
    }
  });

  marcarActiva();
</script>

<style>
  .selector {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    translate: -50% 0;
    z-index: 80;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.8rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--blanco) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(128, 118, 105, 0.25);
    box-shadow: var(--sombra-alta);
  }

  .muestra {
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    padding: 0;
    background: linear-gradient(135deg, var(--muestra-a) 0 50%, var(--muestra-b) 50% 100%);
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .muestra:hover {
    transform: scale(1.15);
  }

  .muestra.activa {
    border-color: var(--tinta);
    transform: scale(1.15);
  }

  .divisor {
    width: 1px;
    height: 1.4rem;
    background: rgba(128, 118, 105, 0.35);
  }

  .esquema {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    border: 0;
    cursor: pointer;
    background: var(--crema);
    color: var(--tinta);
    transition: transform 0.15s ease;
  }

  .esquema:hover {
    transform: scale(1.12);
  }

  .icono-sol {
    display: none;
  }

  :global(html[data-esquema='oscuro']) .icono-luna {
    display: none;
  }

  :global(html[data-esquema='oscuro']) .icono-sol {
    display: block;
  }

  .icono-luna,
  .icono-sol {
    line-height: 0;
  }
</style>
