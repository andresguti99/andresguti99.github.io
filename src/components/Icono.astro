---
/**
 * Ícono oficial de Bootstrap Icons, inyectado como SVG en línea.
 * Uso: <Icono nombre="whatsapp" tamano={22} />
 */
const modulos = import.meta.glob<string>('/node_modules/bootstrap-icons/icons/*.svg', {
  query: '?raw',
  import: 'default',
});

interface Props {
  nombre: string;
  tamano?: number;
}

const { nombre, tamano = 20 } = Astro.props;
const ruta = `/node_modules/bootstrap-icons/icons/${nombre}.svg`;
if (!(ruta in modulos)) {
  throw new Error(`Ícono de Bootstrap desconocido: "${nombre}"`);
}
const original = await modulos[ruta]();
// Sustituye el tamaño fijo de bootstrap-icons; si el formato del SVG cambiara
// en una actualización del paquete, el build falla aquí en vez de dejar
// íconos de 16px por todo el sitio sin aviso.
const svg = original.replace(
  /\swidth="16" height="16"/,
  ` width="${tamano}" height="${tamano}" aria-hidden="true"`
);
if (svg === original) {
  throw new Error(`Icono: no pude ajustar el tamaño de "${nombre}" (¿cambió el formato de bootstrap-icons?)`);
}
---

<Fragment set:html={svg} />
