---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import mapa from '../../images/mexico-map.svg';

// Los pines viven dentro del sistema de coordenadas del propio SVG (viewBox
// 0 0 1024 696), así que escalan con el mapa y no pueden desalinearse jamás.
const ANCHO = 1024;
const ALTO = 696;

const ciudades = (await getCollection('ciudades'))
  .sort((a, b) => a.data.nombre.localeCompare(b.data.nombre))
  .map((ciudad) => ({
    id: ciudad.id,
    nombre: ciudad.data.nombre,
    estado: ciudad.data.estado,
    px: (ciudad.data.x / 100) * ANCHO,
    py: (ciudad.data.y / 100) * ALTO,
  }));
---

<div class="mapa tarjeta">
  <div class="mapa-lienzo">
    <Image src={mapa} alt="Mapa de México" />
    <svg viewBox={`0 0 ${ANCHO} ${ALTO}`}>
      <!-- Capa 1: pines -->
      <g>
        {ciudades.map((ciudad) => (
          <g
            class="pin"
            data-ciudad={ciudad.id}
            tabindex="0"
            role="button"
            aria-label={`Ver desarrollos en ${ciudad.nombre}`}
            transform={`translate(${ciudad.px} ${ciudad.py})`}
          >
            <path class="pin-marca" d="M0 0C-9-13-15-20-15-27a15 15 0 1 1 30 0c0 7-6 14-15 27Z" />
            <circle cx="0" cy="-27" r="6" fill="var(--blanco)" />
          </g>
        ))}
      </g>
      <!-- Capa 2: etiquetas. Van después de TODOS los pines para pintarse
           siempre por encima de ellos. -->
      <g aria-hidden="true">
        {ciudades.map((ciudad) => (
          <text
            class="pin-nombre"
            data-etiqueta={ciudad.id}
            x={ciudad.px}
            y={ciudad.py - 42}
            text-anchor="middle"
          >
            {ciudad.nombre}
          </text>
        ))}
      </g>
    </svg>
  </div>
  <ul class="mapa-leyenda">
    {ciudades.map((ciudad) => (
      <li>
        <button class="leyenda-boton" data-ciudad={ciudad.id}>
          <strong>{ciudad.nombre}</strong>
          {ciudad.estado && <span>, {ciudad.estado}</span>}
        </button>
      </li>
    ))}
  </ul>
</div>

<script>
  const filtrarYNavegar = (ciudad?: string) => {
    if (!ciudad) return;
    window.dispatchEvent(new CustomEvent('filtrar-ciudad', { detail: ciudad }));
    document.querySelector('#desarrollos')?.scrollIntoView({ behavior: 'smooth' });
  };

  document.querySelectorAll<SVGGElement>('.pin').forEach((pin) => {
    const etiqueta = document.querySelector(`[data-etiqueta="${pin.dataset.ciudad}"]`);

    const mostrar = () => etiqueta?.classList.add('visible');
    const ocultar = () => etiqueta?.classList.remove('visible');

    pin.addEventListener('mouseenter', mostrar);
    pin.addEventListener('mouseleave', ocultar);
    pin.addEventListener('focus', mostrar);
    pin.addEventListener('blur', ocultar);

    pin.addEventListener('click', () => filtrarYNavegar(pin.dataset.ciudad));
    pin.addEventListener('keydown', (evento) => {
      if (evento.key === 'Enter' || evento.key === ' ') {
        evento.preventDefault();
        filtrarYNavegar(pin.dataset.ciudad);
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.leyenda-boton').forEach((boton) => {
    boton.addEventListener('click', () => filtrarYNavegar(boton.dataset.ciudad));
  });
</script>

<style>
  .mapa {
    padding: clamp(1rem, 3vw, 2rem);
  }

  .mapa-lienzo {
    position: relative;
  }

  .mapa-lienzo img {
    width: 100%;
    height: auto;
  }

  .mapa-lienzo svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .pin {
    cursor: pointer;
    outline: none;
  }

  .pin-marca {
    fill: var(--terracota);
    stroke: var(--blanco);
    stroke-width: 2.5;
    transition: fill 0.15s ease;
  }

  .pin:hover .pin-marca,
  .pin:focus .pin-marca {
    fill: var(--verde);
  }

  .pin-nombre {
    font-family: var(--titulos);
    font-weight: 800;
    font-size: 26px;
    fill: var(--tinta);
    paint-order: stroke;
    stroke: var(--blanco);
    stroke-width: 8;
    opacity: 0;
    transition: opacity 0.15s ease;
    pointer-events: none;
  }

  .pin-nombre.visible {
    opacity: 1;
  }

  .mapa-leyenda {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    padding: 1rem 0 0;
    margin: 0;
    border-top: 1px solid rgba(43, 38, 32, 0.08);
  }

  .leyenda-boton {
    background: none;
    border: 0;
    padding: 0.2rem 0;
    cursor: pointer;
    font-family: var(--texto);
    font-size: 0.95rem;
    color: var(--tinta-suave);
  }

  .leyenda-boton:hover strong {
    color: var(--verde);
  }

  .leyenda-boton strong {
    color: var(--tinta);
    transition: color 0.15s ease;
  }
</style>
