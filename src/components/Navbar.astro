---
import { Image } from 'astro:assets';
import Icono from './Icono.astro';
import logo from '../../images/UREPPSA/UP_logo.png';
---

<header class="barra">
  <div class="barra-interna">
    <a href="/" class="marca" aria-label="UREPPSA, inicio">
      <Image src={logo} alt="UREPPSA" width={112} densities={[1, 2]} loading="eager" />
    </a>
    <p class="lema">Cada Vivienda un Compromiso</p>
    <nav id="menu-principal" class="menu" aria-label="Navegación principal">
      <a href="/#desarrollos"><Icono nombre="houses-fill" tamano={18} /> Desarrollos</a>
      <a href="/financiamiento/"><Icono nombre="piggy-bank-fill" tamano={18} /> Financiamiento</a>
      <a href="/contacto/" class="btn btn-primario btn-nav"><Icono nombre="telephone-fill" tamano={16} /> Contacto</a>
    </nav>
    <button class="tema-boton" data-tema-boton aria-label="Alternar modo oscuro">
      <span class="icono-luna"><Icono nombre="moon-stars-fill" tamano={18} /></span>
      <span class="icono-sol"><Icono nombre="sun-fill" tamano={18} /></span>
    </button>
    <button class="menu-boton" aria-expanded="false" aria-controls="menu-principal" aria-label="Abrir menú">
      <Icono nombre="list" tamano={32} />
    </button>
  </div>
</header>

<script>
  const boton = document.querySelector('.menu-boton')!;
  const menu = document.querySelector('#menu-principal')!;

  boton.addEventListener('click', () => {
    const abierto = menu.classList.toggle('abierto');
    boton.setAttribute('aria-expanded', String(abierto));
  });

  // Cierra el menú al elegir una opción (navegación por anclas en la misma página)
  menu.querySelectorAll('a').forEach((enlace) =>
    enlace.addEventListener('click', () => {
      menu.classList.remove('abierto');
      boton.setAttribute('aria-expanded', 'false');
    })
  );

  // Alternador de modo oscuro: guarda la preferencia explícita del visitante
  document.querySelector('[data-tema-boton]')?.addEventListener('click', () => {
    const raiz = document.documentElement;
    if (raiz.dataset.esquema === 'oscuro') {
      delete raiz.dataset.esquema;
      localStorage.setItem('esquema', 'claro');
    } else {
      raiz.dataset.esquema = 'oscuro';
      localStorage.setItem('esquema', 'oscuro');
    }
  });
</script>

<style>
  .barra {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #211d18;
    border-bottom: 3px solid var(--verde);
  }

  .barra-interna {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.55rem clamp(1rem, 3vw, 2rem);
  }

  .marca {
    flex-shrink: 0;
    display: block;
  }

  .marca img {
    width: clamp(76px, 8vw, 104px);
    height: auto;
  }

  .lema {
    flex: 1;
    margin: 0;
    text-align: center;
    font-family: var(--titulos);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(0.95rem, 2.2vw, 1.25rem);
    color: #fff;
  }

  .menu {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  .menu a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--titulos);
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    color: #f3ede2;
  }

  .menu a:not(.btn):hover {
    color: var(--amarillo);
  }

  .btn-nav {
    padding: 0.5rem 1.2rem;
    font-size: 0.95rem;
  }

  .menu-boton {
    display: none;
    background: none;
    border: 0;
    color: #fff;
    cursor: pointer;
    padding: 0.25rem;
  }

  .tema-boton {
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 50%;
    width: 2.3rem;
    height: 2.3rem;
    color: #f3ede2;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .tema-boton:hover {
    background: rgba(255, 255, 255, 0.18);
    transform: scale(1.08);
  }

  .icono-sol {
    display: none;
  }

  :global(html[data-esquema='oscuro']) .icono-luna {
    display: none;
  }

  :global(html[data-esquema='oscuro']) .icono-sol {
    display: block;
  }

  .icono-luna,
  .icono-sol {
    line-height: 0;
  }

  @media (max-width: 860px) {
    .menu-boton {
      display: block;
    }

    .menu {
      display: none;
    }

    .menu.abierto {
      display: grid;
      gap: 0.25rem;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #211d18;
      border-bottom: 3px solid var(--verde);
      padding: 0.75rem 1.25rem 1.25rem;
    }

    .menu.abierto a {
      padding: 0.65rem 0;
      font-size: 1.15rem;
    }

    .menu.abierto .btn-nav {
      justify-content: center;
      margin-top: 0.5rem;
    }
  }
</style>
