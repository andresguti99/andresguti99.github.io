---
import { Image } from 'astro:assets';
import logo from '../../images/UREPPSA/UP_logo.png';
---

<header class="barra">
  <div class="contenedor barra-interna">
    <a href="/" class="marca">
      <Image src={logo} alt="UREPPSA" width={120} densities={[1, 2]} />
      <span class="lema">Cada vivienda, un compromiso</span>
    </a>
    <nav aria-label="Navegación principal">
      <a href="/#desarrollos">Desarrollos</a>
      <a href="/#financiamiento">Financiamiento</a>
      <a href="/#contacto" class="btn btn-primario btn-nav">Contacto</a>
    </nav>
  </div>
</header>

<style>
  .barra {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--crema) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(43, 38, 32, 0.07);
  }

  .barra-interna {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.6rem;
  }

  .marca {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    text-decoration: none;
    color: var(--tinta);
  }

  .marca img {
    width: clamp(70px, 9vw, 96px);
    height: auto;
  }

  .lema {
    font-family: var(--titulos);
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--verde-oscuro);
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 2.5vw, 1.6rem);
  }

  nav a:not(.btn) {
    font-family: var(--titulos);
    font-weight: 700;
    text-decoration: none;
    color: var(--tinta);
  }

  nav a:not(.btn):hover {
    color: var(--verde);
  }

  .btn-nav {
    padding: 0.5rem 1.1rem;
    font-size: 0.9rem;
  }

  @media (max-width: 720px) {
    .lema {
      display: none;
    }
  }
</style>
