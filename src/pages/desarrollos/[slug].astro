---
import { getCollection, getEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import TarjetaDesarrollo from '../../components/TarjetaDesarrollo.astro';
import { enlaceWhatsApp, enlaceTelefono, CELULAR_VENTAS, FACEBOOK_UREPPSA } from '../../lib/contacto';

export async function getStaticPaths() {
  const desarrollos = await getCollection('desarrollos');
  return desarrollos.map((d) => ({ params: { slug: d.id }, props: { desarrollo: d } }));
}

const { desarrollo } = Astro.props;
const d = desarrollo.data;
const ciudad = await getEntry(d.ciudad);
const lugar = `${ciudad.data.nombre}${ciudad.data.estado ? `, ${ciudad.data.estado}` : ''}`;
const mensajeWA = `Quiero informes de ${d.nombre}`;
// Respaldo a los datos generales cuando el desarrollo no tiene los propios
const telefonoContacto = d.telefono ?? CELULAR_VENTAS;
const facebookContacto = d.facebook ?? FACEBOOK_UREPPSA;

// La descripción llega como líneas separadas por <br>; se muestran como lista
// con guiones para que cada punto se distinga de un vistazo.
const lineasDescripcion = d.descripcion
  .split(/<br\s*\/?\s*>/i)
  .map((linea) => linea.trim())
  .filter(Boolean);

// Versión grande de cada imagen para el visor de pantalla completa.
const ampliar = (img: ImageMetadata) => getImage({ src: img, width: 1600 });
const galeria = await Promise.all(
  d.imagenes.map(async (img) => ({ img, grande: await ampliar(img) }))
);
const modelos = await Promise.all(
  (d.modelos ?? []).map(async (m) => ({
    ...m,
    galeria: await Promise.all(m.imagenes.map(async (img) => ({ img, grande: await ampliar(img) }))),
    planosGrandes: await Promise.all((m.planos ?? []).map(async (img) => ({ img, grande: await ampliar(img) }))),
  }))
);
const planosProyecto = await Promise.all(
  (d.planos ?? []).map(async (img) => ({ img, grande: await ampliar(img) }))
);

// Otros desarrollos para seguir explorando: primero los de la misma ciudad.
const todos = (await getCollection('desarrollos')).sort((a, b) => b.data.anio - a.data.anio);
const ciudades = await getCollection('ciudades');
const nombreCiudad = (id: string) => ciudades.find((c) => c.id === id)?.data.nombre ?? id;
const otros = [
  ...todos.filter((o) => o.id !== desarrollo.id && o.data.ciudad.id === d.ciudad.id),
  ...todos.filter((o) => o.id !== desarrollo.id && o.data.ciudad.id !== d.ciudad.id),
].slice(0, 3);

// Ficha técnica: etiqueta, valor e ícono; solo se muestran los presentes.
type Vivienda = {
  plantas?: string;
  recamaras?: string;
  banos?: string;
  superficie?: string;
  construccion?: string;
};
const ficha = (v: Vivienda) =>
  (
    [
      ['Plantas', v.plantas, 'building-fill'],
      ['Recámaras', v.recamaras, 'door-open-fill'],
      ['Baños', v.banos, 'droplet-fill'],
      ['Terreno', v.superficie, 'arrows-angle-expand'],
      ['Construcción', v.construccion, 'bricks'],
    ] as const
  ).filter(([, valor]) => valor) as [string, string, string][];

const etiquetaPlano = (total: number, i: number) => {
  if (total === 1) return 'Planta arquitectónica';
  return i === 0 ? 'Planta baja' : i === 1 ? 'Planta alta' : `Planta ${i + 1}`;
};

// Imagen para la tarjeta al compartir el proyecto en WhatsApp/Facebook.
const imagenSocial = (await getImage({ src: d.imagenes[0], width: 1200 })).src;

// Filas del comparador de modelos (solo las que algún modelo tiene).
const filasComparador = (
  [
    ['Precio', (m: (typeof modelos)[number]) => m.precio],
    ['Plantas', (m) => m.plantas],
    ['Recámaras', (m) => m.recamaras],
    ['Baños', (m) => m.banos],
    ['Terreno', (m) => m.superficie],
    ['Construcción', (m) => m.construccion],
  ] as [string, (m: (typeof modelos)[number]) => string | undefined][]
).filter(([, valor]) => modelos.some((m) => valor(m)));

// Navegación interna de la página
const secciones = [
  { href: '#galeria', texto: 'Galería' },
  ...(d.tourVirtual ? [{ href: '#tour', texto: 'Recorrido' }] : []),
  ...(modelos.length > 0 ? [{ href: '#modelos', texto: 'Modelos' }] : [{ href: '#vivienda', texto: 'La vivienda' }]),
  { href: '#ubicacion', texto: 'Ubicación' },
];
---

<Base
  titulo={`${d.nombre} | UREPPSA`}
  descripcion={`${d.nombre} en ${lugar}. ${d.precio}. Desarrollo habitacional de UREPPSA.`}
  mensajeWhatsApp={mensajeWA}
  imagenSocial={imagenSocial}
>
  <!-- ══ Héroe ══ -->
  <section class="heroe-desarrollo">
    <Image
      class="heroe-fondo"
      src={d.imagenes[0]}
      alt=""
      width={1920}
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="heroe-velo"></div>
    <div class="contenedor heroe-contenido">
      <nav class="miga">
        <a href="/#desarrollos" class="miga-chip">
          <Icono nombre="chevron-left" tamano={14} /> Todos los desarrollos
        </a>
      </nav>
      <div class="heroe-panel">
        {d.logo && (
          <Image class="heroe-logo" src={d.logo} alt="" width={96} densities={[1, 2]} loading="eager" />
        )}
        <div class="heroe-datos">
          <h1>{d.nombre}</h1>
          <p class="heroe-lugar"><Icono nombre="geo-alt-fill" tamano={15} /> {lugar}</p>
          <div class="heroe-precio-fila">
            <span class={`pildora ${d.disponible ? 'pildora-disponible' : 'pildora-vendido'}`}>
              {d.disponible ? 'Disponible' : 'Vendido'}
            </span>
            <span class="heroe-precio">{d.precio}</span>
            {modelos.length > 0 && (
              <span class="heroe-chip"><Icono nombre="houses-fill" tamano={14} /> {modelos.length} modelos de vivienda</span>
            )}
            {d.tourVirtual && (
              <span class="heroe-chip"><Icono nombre="badge-vr" tamano={16} /> Recorrido virtual</span>
            )}
          </div>
        </div>
        {d.disponible && (
          <a
            class="btn btn-whatsapp heroe-cta"
            href={enlaceWhatsApp(telefonoContacto, mensajeWA)}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icono nombre="whatsapp" /> Quiero informes
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- ══ Navegación interna pegajosa ══ -->
  <div data-subnav-sentinela></div>
  <nav class="subnav" aria-label="Secciones del desarrollo" data-subnav>
    <div class="contenedor subnav-interno">
      <a href="#" class="subnav-identidad" aria-label={`Volver al inicio de ${d.nombre}`}>
        {d.logo && <Image src={d.logo} alt="" width={30} height={30} densities={[1, 2]} loading="eager" />}
        <span>{d.nombre}</span>
      </a>
      <div class="subnav-enlaces">
        {secciones.map((s) => (
          <a href={s.href}>{s.texto}</a>
        ))}
      </div>
      <a
        class="btn btn-whatsapp subnav-cta"
        href={enlaceWhatsApp(telefonoContacto, mensajeWA)}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icono nombre="whatsapp" tamano={16} /> <span>Informes</span>
      </a>
    </div>
  </nav>

  <div class="contenedor">
    <!-- ══ Descripción ══ -->
    <section class="seccion seccion-compacta">
      <div class="descripcion revelar">
        {lineasDescripcion.length > 1 ? (
          <ul class="descripcion-lista">
            {lineasDescripcion.map((linea) => <li set:html={linea} />)}
          </ul>
        ) : (
          <div class="prosa" set:html={d.descripcion} />
        )}
      </div>
    </section>

    <!-- ══ Galería (mosaico bento) ══ -->
    <section class="seccion seccion-compacta" id="galeria">
      <div class="seccion-encabezado revelar">
        <span class="etiqueta">Galería</span>
        <h2>Conócelo en imágenes</h2>
      </div>
      <div class="galeria revelar" style="--retraso: 100ms">
        {galeria.map((g, i) => (
          <button
            class="galeria-item"
            data-visor={g.grande.src}
            aria-label={`Ampliar fotografía ${i + 1} de ${d.nombre}`}
          >
            <Image
              src={g.img}
              alt={`${d.nombre}, fotografía ${i + 1}`}
              width={960}
              widths={[420, 640, 960]}
              sizes="(max-width: 720px) 74vw, (min-width: 721px) 40vw"
              loading={i < 3 ? 'eager' : 'lazy'}
            />
            <span class="galeria-lupa" aria-hidden="true"><Icono nombre="arrows-fullscreen" tamano={18} /></span>
          </button>
        ))}
      </div>
    </section>

    <!-- ══ Tour virtual ══ -->
    {d.tourVirtual && (
      <section class="seccion seccion-compacta" id="tour">
        <div class="seccion-encabezado revelar">
          <span class="etiqueta">Recorrido 360°</span>
          <h2>Camina la casa muestra</h2>
          <p>Explórala a tu ritmo, como si ya estuvieras ahí.</p>
        </div>
        <div class="marco marco-tour tarjeta revelar" style="--retraso: 100ms" set:html={d.tourVirtual} />
      </section>
    )}

    <!-- ══ Modelos de vivienda ══ -->
    {modelos.length > 0 && (
      <section class="seccion seccion-compacta" id="modelos">
        <div class="seccion-encabezado revelar">
          <span class="etiqueta">Modelos</span>
          <h2>Elige el modelo para tu familia</h2>
          <p>Cada modelo con sus fotos, planos y características completas.</p>
        </div>
        <div class="rejilla-modelos">
          {modelos.map((m, i) => (
            <article class="tarjeta modelo-tarjeta revelar" style={`--retraso: ${i * 90}ms`}>
              <div class="modelo-foto">
                <Image
                  src={m.imagenes[0]}
                  alt={`Modelo ${m.nombre}`}
                  width={640}
                  widths={[420, 640]}
                  sizes="(max-width: 720px) 100vw, 33vw"
                  loading="lazy"
                />
                {m.precio ? (
                  <span class="modelo-precio-chip">{m.precio}</span>
                ) : (
                  <a
                    class="modelo-precio-chip modelo-precio-enlace"
                    href={enlaceWhatsApp(telefonoContacto, `Quiero saber el precio del modelo ${m.nombre} en ${d.nombre}`)}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Icono nombre="whatsapp" tamano={14} /> Consultar precio
                  </a>
                )}
              </div>
              <div class="modelo-cuerpo">
                {m.etapa && <p class="modelo-etapa">{m.etapa}</p>}
                <h3>{m.nombre}</h3>
                <ul class="modelo-datos">
                  {/* En la tarjeta solo la cifra compacta; el detalle completo vive en el diálogo */}
                  {m.recamaras && <li><Icono nombre="door-open-fill" tamano={15} /> {m.recamaras.split(' ')[0]} rec.</li>}
                  {m.banos && <li><Icono nombre="droplet-fill" tamano={15} /> {m.banos} baños</li>}
                  {m.construccion && <li><Icono nombre="bricks" tamano={15} /> {m.construccion.split(' ')[0]} m²</li>}
                </ul>
                <button class="btn btn-primario modelo-abrir" data-abrir-modelo={i}>
                  Ver modelo <Icono nombre="chevron-right" tamano={16} />
                </button>
              </div>
            </article>
          ))}
        </div>

        {modelos.length > 1 && (
          <div class="comparador tarjeta revelar">
            <h3>Compara los modelos</h3>
            <div class="comparador-tabla">
              <table>
                <thead>
                  <tr>
                    <th scope="col"><span class="solo-lector">Característica</span></th>
                    {modelos.map((m) => <th scope="col">{m.nombre}</th>)}
                  </tr>
                </thead>
                <tbody>
                  {filasComparador.map(([etiqueta, valor]) => (
                    <tr class={etiqueta === 'Precio' ? 'fila-precio' : ''}>
                      <th scope="row">{etiqueta}</th>
                      {modelos.map((m) => (
                        <td>
                          {etiqueta === 'Precio' && !m.precio ? (
                            <a
                              class="consultar-enlace"
                              href={enlaceWhatsApp(telefonoContacto, `Quiero saber el precio del modelo ${m.nombre} en ${d.nombre}`)}
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              <Icono nombre="whatsapp" tamano={14} /> Consultar precio
                            </a>
                          ) : (
                            valor(m) ?? '—'
                          )}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </section>
    )}

    <!-- ══ El conjunto (desarrollos con modelos) ══ -->
    {modelos.length > 0 && d.caracteristicasConjunto && (
      <section class="seccion seccion-compacta">
        <div class="seccion-encabezado revelar">
          <span class="etiqueta">El conjunto</span>
          <h2>Un conjunto pensado para vivirse</h2>
        </div>
        <div class="prosa conjunto-prosa revelar" style="--retraso: 100ms" set:html={d.caracteristicasConjunto} />
      </section>
    )}

    <!-- ══ Ficha del desarrollo sin modelos ══ -->
    {modelos.length === 0 && (
      <section class="seccion seccion-compacta" id="vivienda">
        <div class="seccion-encabezado revelar">
          <span class="etiqueta">La vivienda</span>
          <h2>{d.nombreModelo ? `Modelo ${d.nombreModelo}` : 'Así es tu futura casa'}</h2>
        </div>
        <dl class="ficha revelar">
          {ficha(d).map(([etiqueta, valor, icono]) => (
            <div>
              <dt><Icono nombre={icono} tamano={16} /> {etiqueta}</dt>
              <dd>{valor}</dd>
            </div>
          ))}
        </dl>
        {planosProyecto.length > 0 && (
          <div class="planos revelar" style="--retraso: 80ms">
            {planosProyecto.map((p, i) => (
              <figure>
                <button class="galeria-item" data-visor={p.grande.src} aria-label={`Ampliar ${etiquetaPlano(planosProyecto.length, i)}`}>
                  <Image
                    src={p.img}
                    alt={`${d.nombre}: ${etiquetaPlano(planosProyecto.length, i)}`}
                    width={640}
                    widths={[420, 640]}
                    sizes="(max-width: 720px) 100vw, 45vw"
                    loading="lazy"
                  />
                  <span class="galeria-lupa" aria-hidden="true"><Icono nombre="arrows-fullscreen" tamano={18} /></span>
                </button>
                <figcaption>{etiquetaPlano(planosProyecto.length, i)}</figcaption>
              </figure>
            ))}
          </div>
        )}
        {(d.caracteristicasVivienda || d.caracteristicasConjunto) && (
          <div class="columnas-caracteristicas revelar" style="--retraso: 120ms">
            {d.caracteristicasVivienda && (
              <div>
                <h3>La vivienda</h3>
                <div class="prosa" set:html={d.caracteristicasVivienda} />
              </div>
            )}
            {d.caracteristicasConjunto && (
              <div>
                <h3>El conjunto</h3>
                <div class="prosa" set:html={d.caracteristicasConjunto} />
              </div>
            )}
          </div>
        )}
      </section>
    )}

    <!-- ══ Ubicación y contacto ══ -->
    <section class="seccion seccion-compacta" id="ubicacion">
      <div class="seccion-encabezado revelar">
        <span class="etiqueta">Ubicación</span>
        <h2>¿Dónde está {d.nombre}?</h2>
      </div>
      <div class="ubicacion-contacto">
        <div class="revelar">
          {d.ubicacion && <div class="prosa" set:html={d.ubicacion} />}
          {d.mapa && <div class="marco marco-mapa" set:html={d.mapa} />}
        </div>
        <aside class="contacto-panel revelar" style="--retraso: 120ms">
          <h2>¿Te interesa {d.nombre}?</h2>
          <p>Escríbenos y con gusto te damos informes, sin compromiso.</p>
          <a
            href={enlaceWhatsApp(telefonoContacto, mensajeWA)}
            class="btn btn-whatsapp"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icono nombre="whatsapp" /> WhatsApp
          </a>
          <a href={enlaceTelefono(telefonoContacto)} class="btn btn-claro">
            <Icono nombre="telephone-fill" tamano={16} /> {telefonoContacto}
          </a>
          <a href={facebookContacto} target="_blank" rel="noopener noreferrer" class="contacto-facebook">
            <Icono nombre="facebook" tamano={17} /> Síguenos en Facebook
          </a>
        </aside>
      </div>
    </section>

    <!-- ══ Otros desarrollos ══ -->
    {otros.length > 0 && (
      <section class="seccion seccion-compacta">
        <div class="seccion-encabezado revelar">
          <span class="etiqueta">Sigue explorando</span>
          <h2>Otros desarrollos UREPPSA</h2>
        </div>
        <div class="rejilla-otros">
          {otros.map((o, i) => (
            <div class="revelar" style={`--retraso: ${i * 90}ms`}>
              <TarjetaDesarrollo desarrollo={o} nombreCiudad={nombreCiudad(o.data.ciudad.id)} />
            </div>
          ))}
        </div>
      </section>
    )}
  </div>

  <!-- ══ Diálogo por modelo ══ -->
  {modelos.map((m, i) => (
    <dialog class="modal-modelo" data-modelo={i} aria-label={`Modelo ${m.nombre}`}>
      <header class="modal-encabezado">
        <div>
          {m.etapa && <p class="modelo-etapa">{m.etapa}</p>}
          <h3>{m.nombre}</h3>
          {m.precio ? (
            <p class="modal-precio">{m.precio}</p>
          ) : (
            <a
              class="modal-precio consultar-enlace"
              href={enlaceWhatsApp(telefonoContacto, `Quiero saber el precio del modelo ${m.nombre} en ${d.nombre}`)}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icono nombre="whatsapp" tamano={15} /> Consultar precio
            </a>
          )}
        </div>
        <button class="modal-cerrar" data-cerrar aria-label="Cerrar">
          <Icono nombre="x-lg" tamano={22} />
        </button>
      </header>
      <div class="modal-galeria">
        {m.galeria.map((g, j) => (
          <button class="galeria-item" data-visor={g.grande.src} aria-label={`Ampliar fotografía ${j + 1} del modelo ${m.nombre}`}>
            <Image
              src={g.img}
              alt={`Modelo ${m.nombre}, fotografía ${j + 1}`}
              width={560}
              widths={[360, 560]}
              sizes="(max-width: 720px) 50vw, 25vw"
              loading="lazy"
            />
            <span class="galeria-lupa" aria-hidden="true"><Icono nombre="arrows-fullscreen" tamano={16} /></span>
          </button>
        ))}
      </div>
      <dl class="ficha">
        {ficha(m).map(([etiqueta, valor, icono]) => (
          <div>
            <dt><Icono nombre={icono} tamano={15} /> {etiqueta}</dt>
            <dd>{valor}</dd>
          </div>
        ))}
      </dl>
      {m.distribucion && (
        <>
          <h4>Distribución</h4>
          <div class="prosa distribucion" set:html={m.distribucion} />
        </>
      )}
      {m.planosGrandes.length > 0 && (
        <>
          <h4>Planos</h4>
          <div class="planos">
            {m.planosGrandes.map((p, j) => (
              <figure>
                <button class="galeria-item" data-visor={p.grande.src} aria-label={`Ampliar ${etiquetaPlano(m.planosGrandes.length, j)}`}>
                  <Image
                    src={p.img}
                    alt={`${m.nombre}: ${etiquetaPlano(m.planosGrandes.length, j)}`}
                    width={640}
                    widths={[420, 640]}
                    sizes="(max-width: 720px) 100vw, 40vw"
                    loading="lazy"
                  />
                  <span class="galeria-lupa" aria-hidden="true"><Icono nombre="arrows-fullscreen" tamano={16} /></span>
                </button>
                <figcaption>{etiquetaPlano(m.planosGrandes.length, j)}</figcaption>
              </figure>
            ))}
          </div>
        </>
      )}
      <div class="columnas-caracteristicas">
        {m.caracteristicasVivienda && (
          <div>
            <h4>La vivienda</h4>
            <div class="prosa" set:html={m.caracteristicasVivienda} />
          </div>
        )}
        {m.caracteristicasConjunto && (
          <div>
            <h4>El conjunto</h4>
            <div class="prosa" set:html={m.caracteristicasConjunto} />
          </div>
        )}
      </div>
      {d.disponible && (
        <a
          href={enlaceWhatsApp(telefonoContacto, `Quiero informes del modelo ${m.nombre} en ${d.nombre}`)}
          class="btn btn-whatsapp"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icono nombre="whatsapp" /> Informes del modelo {m.nombre}
        </a>
      )}
    </dialog>
  ))}

  <!-- ══ Visor de imágenes en pantalla completa ══ -->
  <dialog class="visor" data-visor-dialogo aria-label="Visor de fotografías">
    <button class="visor-boton visor-cerrar" data-cerrar aria-label="Cerrar">
      <Icono nombre="x-lg" tamano={24} />
    </button>
    <button class="visor-boton visor-prev" aria-label="Fotografía anterior">
      <Icono nombre="chevron-left" tamano={28} />
    </button>
    <img alt="Fotografía ampliada" />
    <button class="visor-boton visor-sig" aria-label="Fotografía siguiente">
      <Icono nombre="chevron-right" tamano={28} />
    </button>
    <p class="visor-contador"></p>
  </dialog>
</Base>

<script>
  // ── Altura real de la barra de navegación, para que la subnav se pegue justo debajo ──
  const barra = document.querySelector<HTMLElement>('.barra');
  const medirBarra = () =>
    document.documentElement.style.setProperty('--alto-barra', `${barra?.offsetHeight ?? 72}px`);
  medirBarra();
  window.addEventListener('resize', medirBarra);

  // ── Identidad del proyecto en la subnav: aparece cuando la barra se pega ──
  const subnavEl = document.querySelector<HTMLElement>('[data-subnav]')!;
  const sentinela = document.querySelector('[data-subnav-sentinela]')!;
  new IntersectionObserver(
    ([entrada]) => subnavEl.classList.toggle('pegada', !entrada.isIntersecting),
    { rootMargin: `-${(barra?.offsetHeight ?? 72) + 1}px 0px 0px 0px` }
  ).observe(sentinela);

  // ── Scrollspy: resalta la sección visible en la subnav ──
  const enlacesSubnav = [...document.querySelectorAll<HTMLAnchorElement>('.subnav-enlaces a')];
  const espia = new IntersectionObserver(
    (entradas) => {
      entradas.forEach((entrada) => {
        if (entrada.isIntersecting) {
          enlacesSubnav.forEach((enlace) =>
            enlace.classList.toggle('activo', enlace.hash === `#${entrada.target.id}`)
          );
        }
      });
    },
    { rootMargin: '-35% 0px -55% 0px' }
  );
  enlacesSubnav.forEach((enlace) => {
    const seccion = document.querySelector(enlace.hash);
    if (seccion) espia.observe(seccion);
  });

  // ── Diálogos de modelos ──
  document.querySelectorAll<HTMLButtonElement>('[data-abrir-modelo]').forEach((boton) => {
    boton.addEventListener('click', () => {
      document
        .querySelector<HTMLDialogElement>(`dialog[data-modelo="${boton.dataset.abrirModelo}"]`)
        ?.showModal();
    });
  });

  document.querySelectorAll<HTMLDialogElement>('dialog').forEach((dialogo) => {
    dialogo.querySelector('[data-cerrar]')?.addEventListener('click', () => dialogo.close());
    // Clic en el fondo oscuro = cerrar
    dialogo.addEventListener('click', (evento) => {
      if (evento.target === dialogo) dialogo.close();
    });
  });

  // ── Visor de pantalla completa ──
  const visor = document.querySelector<HTMLDialogElement>('[data-visor-dialogo]')!;
  const visorImg = visor.querySelector('img')!;
  const contador = visor.querySelector('.visor-contador')!;
  const disparadores = [...document.querySelectorAll<HTMLElement>('[data-visor]')];
  let indiceActual = 0;

  const mostrarFoto = (indice: number) => {
    indiceActual = (indice + disparadores.length) % disparadores.length;
    visorImg.src = disparadores[indiceActual].dataset.visor!;
    contador.textContent = `${indiceActual + 1} / ${disparadores.length}`;
  };

  disparadores.forEach((disparador, i) => {
    disparador.addEventListener('click', () => {
      mostrarFoto(i);
      visor.showModal();
    });
  });

  visor.querySelector('.visor-prev')!.addEventListener('click', () => mostrarFoto(indiceActual - 1));
  visor.querySelector('.visor-sig')!.addEventListener('click', () => mostrarFoto(indiceActual + 1));
  visor.addEventListener('keydown', (evento) => {
    if (evento.key === 'ArrowLeft') mostrarFoto(indiceActual - 1);
    if (evento.key === 'ArrowRight') mostrarFoto(indiceActual + 1);
  });
</script>

