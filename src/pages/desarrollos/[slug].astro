---
import { getCollection, getEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import { enlaceWhatsApp } from '../../lib/contacto';

export async function getStaticPaths() {
  const desarrollos = await getCollection('desarrollos');
  return desarrollos.map((d) => ({ params: { slug: d.id }, props: { desarrollo: d } }));
}

const { desarrollo } = Astro.props;
const d = desarrollo.data;
const ciudad = await getEntry(d.ciudad);
const lugar = `${ciudad.data.nombre}${ciudad.data.estado ? `, ${ciudad.data.estado}` : ''}`;
const mensajeWA = `Quiero informes de ${d.nombre}`;

// Versión grande de cada imagen para el visor de pantalla completa.
const ampliar = (img: ImageMetadata) => getImage({ src: img, width: 1600 });
const galeria = await Promise.all(
  d.imagenes.map(async (img) => ({ img, grande: await ampliar(img) }))
);
const modelos = await Promise.all(
  (d.modelos ?? []).map(async (m) => ({
    ...m,
    galeria: await Promise.all(m.imagenes.map(async (img) => ({ img, grande: await ampliar(img) }))),
    planosGrandes: await Promise.all((m.planos ?? []).map(async (img) => ({ img, grande: await ampliar(img) }))),
  }))
);
const planosProyecto = await Promise.all(
  (d.planos ?? []).map(async (img) => ({ img, grande: await ampliar(img) }))
);

// Pares etiqueta/valor de la ficha técnica; solo se muestran los presentes.
const ficha = (v: { plantas?: string; recamaras?: string; banos?: string; superficie?: string; construccion?: string }) =>
  [
    ['Plantas', v.plantas],
    ['Recámaras', v.recamaras],
    ['Baños', v.banos],
    ['Terreno', v.superficie],
    ['Construcción', v.construccion],
  ].filter(([, valor]) => valor) as [string, string][];

const etiquetaPlano = (total: number, i: number) => {
  if (total === 1) return 'Planta arquitectónica';
  return i === 0 ? 'Planta baja' : i === 1 ? 'Planta alta' : `Planta ${i + 1}`;
};
---

<Base
  titulo={`${d.nombre} | UREPPSA`}
  descripcion={`${d.nombre} en ${lugar}. ${d.precio}. Desarrollo habitacional de UREPPSA.`}
  mensajeWhatsApp={mensajeWA}
>
  <!-- Héroe del desarrollo -->
  <section class="heroe-desarrollo">
    <Image
      class="heroe-fondo"
      src={d.imagenes[0]}
      alt=""
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
    />
    <div class="heroe-velo"></div>
    <div class="contenedor heroe-contenido">
      <nav class="miga"><a href="/#desarrollos">← Todos los desarrollos</a></nav>
      <div class="heroe-datos">
        {d.logo && <Image class="heroe-logo" src={d.logo} alt="" width={96} densities={[1, 2]} loading="eager" />}
        <div>
          <h1>{d.nombre}</h1>
          <p class="heroe-lugar">{lugar}</p>
          <div class="heroe-precio-fila">
            <span class={`pildora ${d.disponible ? 'pildora-disponible' : 'pildora-vendido'}`}>
              {d.disponible ? 'Disponible' : 'Vendido'}
            </span>
            <span class="heroe-precio">{d.precio}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="contenedor">
    <!-- Descripción -->
    <section class="seccion seccion-compacta">
      <div class="descripcion prosa" set:html={d.descripcion} />
      {d.disponible && (
        <a
          href={enlaceWhatsApp(d.telefono, mensajeWA)}
          class="btn btn-whatsapp"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icono nombre="whatsapp" /> Quiero informes
        </a>
      )}
    </section>

    <!-- Galería -->
    <section class="seccion seccion-compacta">
      <h2>Galería</h2>
      <div class="galeria">
        {galeria.map((g, i) => (
          <button class="galeria-item" data-visor={g.grande.src} aria-label={`Ampliar fotografía ${i + 1} de ${d.nombre}`}>
            <Image
              src={g.img}
              alt={`${d.nombre}, fotografía ${i + 1}`}
              widths={[420, 640, 960]}
              sizes="(max-width: 720px) 50vw, 33vw"
              loading={i < 3 ? 'eager' : 'lazy'}
            />
          </button>
        ))}
      </div>
    </section>

    <!-- Tour virtual -->
    {d.tourVirtual && (
      <section class="seccion seccion-compacta">
        <h2>Recorre la casa muestra</h2>
        <div class="marco marco-tour" set:html={d.tourVirtual} />
      </section>
    )}

    <!-- Modelos de vivienda -->
    {modelos.length > 0 && (
      <section class="seccion seccion-compacta" id="modelos">
        <h2>Modelos de vivienda</h2>
        <p class="seccion-nota">Elige un modelo para ver sus fotos, planos y características completas.</p>
        <div class="rejilla-modelos">
          {modelos.map((m, i) => (
            <article class="tarjeta modelo-tarjeta">
              <div class="modelo-foto">
                <Image
                  src={m.imagenes[0]}
                  alt={`Modelo ${m.nombre}`}
                  widths={[420, 640]}
                  sizes="(max-width: 720px) 100vw, 33vw"
                  loading="lazy"
                />
              </div>
              <div class="modelo-cuerpo">
                <h3>{m.nombre}</h3>
                <p class="modelo-precio">{m.precio}</p>
                <ul class="modelo-datos">
                  {m.recamaras && <li><Icono nombre="door-open-fill" tamano={15} /> {m.recamaras} rec.</li>}
                  {m.banos && <li><Icono nombre="droplet-fill" tamano={15} /> {m.banos} baños</li>}
                  {m.plantas && <li><Icono nombre="building-fill" tamano={15} /> {m.plantas} plantas</li>}
                </ul>
                <button class="btn btn-primario modelo-abrir" data-abrir-modelo={i}>Ver modelo</button>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Ficha técnica del desarrollo sin modelos -->
    {modelos.length === 0 && (
      <section class="seccion seccion-compacta">
        <h2>La vivienda</h2>
        <dl class="ficha">
          {ficha(d).map(([etiqueta, valor]) => (
            <div>
              <dt>{etiqueta}</dt>
              <dd>{valor}</dd>
            </div>
          ))}
        </dl>
        {planosProyecto.length > 0 && (
          <div class="planos">
            {planosProyecto.map((p, i) => (
              <figure>
                <button class="galeria-item" data-visor={p.grande.src} aria-label={`Ampliar ${etiquetaPlano(planosProyecto.length, i)}`}>
                  <Image
                    src={p.img}
                    alt={`${d.nombre}: ${etiquetaPlano(planosProyecto.length, i)}`}
                    widths={[420, 640]}
                    sizes="(max-width: 720px) 100vw, 45vw"
                    loading="lazy"
                  />
                </button>
                <figcaption>{etiquetaPlano(planosProyecto.length, i)}</figcaption>
              </figure>
            ))}
          </div>
        )}
        {(d.caracteristicasVivienda || d.caracteristicasConjunto) && (
          <div class="columnas-caracteristicas">
            {d.caracteristicasVivienda && (
              <div>
                <h3>La vivienda</h3>
                <div class="prosa" set:html={d.caracteristicasVivienda} />
              </div>
            )}
            {d.caracteristicasConjunto && (
              <div>
                <h3>El conjunto</h3>
                <div class="prosa" set:html={d.caracteristicasConjunto} />
              </div>
            )}
          </div>
        )}
      </section>
    )}

    <!-- Ubicación y contacto -->
    <section class="seccion seccion-compacta" id="ubicacion">
      <div class="ubicacion-contacto">
        <div>
          <h2>Ubicación</h2>
          {d.ubicacion && <div class="prosa" set:html={d.ubicacion} />}
          {d.mapa && <div class="marco marco-mapa" set:html={d.mapa} />}
        </div>
        <aside class="tarjeta contacto-panel">
          <h2>¿Te interesa {d.nombre}?</h2>
          <p>Escríbenos y con gusto te damos informes, sin compromiso.</p>
          <a
            href={enlaceWhatsApp(d.telefono, mensajeWA)}
            class="btn btn-whatsapp"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icono nombre="whatsapp" /> WhatsApp
          </a>
          <a href={`tel:${d.telefono.replace(/\s/g, '')}`} class="btn btn-secundario">
            <Icono nombre="telephone-fill" tamano={16} /> {d.telefono}
          </a>
          {d.facebook && (
            <a href={d.facebook} target="_blank" rel="noopener noreferrer" class="contacto-facebook">
              <Icono nombre="facebook" tamano={17} /> Síguenos en Facebook
            </a>
          )}
        </aside>
      </div>
    </section>
  </div>

  <!-- Diálogo por modelo -->
  {modelos.map((m, i) => (
    <dialog class="modal-modelo" data-modelo={i} aria-label={`Modelo ${m.nombre}`}>
      <header class="modal-encabezado">
        <div>
          <h3>{m.nombre}</h3>
          <p class="modelo-precio">{m.precio}</p>
        </div>
        <button class="modal-cerrar" data-cerrar aria-label="Cerrar">
          <Icono nombre="x-lg" tamano={22} />
        </button>
      </header>
      <div class="modal-galeria">
        {m.galeria.map((g, j) => (
          <button class="galeria-item" data-visor={g.grande.src} aria-label={`Ampliar fotografía ${j + 1} del modelo ${m.nombre}`}>
            <Image
              src={g.img}
              alt={`Modelo ${m.nombre}, fotografía ${j + 1}`}
              widths={[360, 560]}
              sizes="(max-width: 720px) 50vw, 25vw"
              loading="lazy"
            />
          </button>
        ))}
      </div>
      <dl class="ficha">
        {ficha(m).map(([etiqueta, valor]) => (
          <div>
            <dt>{etiqueta}</dt>
            <dd>{valor}</dd>
          </div>
        ))}
      </dl>
      {m.planosGrandes.length > 0 && (
        <>
          <h4>Planos</h4>
          <div class="planos">
            {m.planosGrandes.map((p, j) => (
              <figure>
                <button class="galeria-item" data-visor={p.grande.src} aria-label={`Ampliar ${etiquetaPlano(m.planosGrandes.length, j)}`}>
                  <Image
                    src={p.img}
                    alt={`${m.nombre}: ${etiquetaPlano(m.planosGrandes.length, j)}`}
                    widths={[420, 640]}
                    sizes="(max-width: 720px) 100vw, 40vw"
                    loading="lazy"
                  />
                </button>
                <figcaption>{etiquetaPlano(m.planosGrandes.length, j)}</figcaption>
              </figure>
            ))}
          </div>
        </>
      )}
      <div class="columnas-caracteristicas">
        {m.caracteristicasVivienda && (
          <div>
            <h4>La vivienda</h4>
            <div class="prosa" set:html={m.caracteristicasVivienda} />
          </div>
        )}
        {m.caracteristicasConjunto && (
          <div>
            <h4>El conjunto</h4>
            <div class="prosa" set:html={m.caracteristicasConjunto} />
          </div>
        )}
      </div>
      {d.disponible && (
        <a
          href={enlaceWhatsApp(d.telefono, `Quiero informes del modelo ${m.nombre} en ${d.nombre}`)}
          class="btn btn-whatsapp"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icono nombre="whatsapp" /> Informes del modelo {m.nombre}
        </a>
      )}
    </dialog>
  ))}

  <!-- Visor de imágenes en pantalla completa -->
  <dialog class="visor" data-visor-dialogo aria-label="Visor de fotografías">
    <button class="visor-boton visor-cerrar" data-cerrar aria-label="Cerrar">
      <Icono nombre="x-lg" tamano={24} />
    </button>
    <button class="visor-boton visor-prev" aria-label="Fotografía anterior">
      <Icono nombre="chevron-left" tamano={28} />
    </button>
    <img alt="Fotografía ampliada" />
    <button class="visor-boton visor-sig" aria-label="Fotografía siguiente">
      <Icono nombre="chevron-right" tamano={28} />
    </button>
    <p class="visor-contador"></p>
  </dialog>
</Base>

<script>
  // ── Diálogos de modelos ───────────────────────────────────────────────
  document.querySelectorAll<HTMLButtonElement>('[data-abrir-modelo]').forEach((boton) => {
    boton.addEventListener('click', () => {
      document
        .querySelector<HTMLDialogElement>(`dialog[data-modelo="${boton.dataset.abrirModelo}"]`)
        ?.showModal();
    });
  });

  document.querySelectorAll<HTMLDialogElement>('dialog').forEach((dialogo) => {
    dialogo.querySelector('[data-cerrar]')?.addEventListener('click', () => dialogo.close());
    // Clic en el fondo oscuro = cerrar
    dialogo.addEventListener('click', (evento) => {
      if (evento.target === dialogo) dialogo.close();
    });
  });

  // ── Visor de pantalla completa ────────────────────────────────────────
  const visor = document.querySelector<HTMLDialogElement>('[data-visor-dialogo]')!;
  const visorImg = visor.querySelector('img')!;
  const contador = visor.querySelector('.visor-contador')!;
  const disparadores = [...document.querySelectorAll<HTMLElement>('[data-visor]')];
  let indiceActual = 0;

  const mostrarFoto = (indice: number) => {
    indiceActual = (indice + disparadores.length) % disparadores.length;
    visorImg.src = disparadores[indiceActual].dataset.visor!;
    contador.textContent = `${indiceActual + 1} / ${disparadores.length}`;
  };

  disparadores.forEach((disparador, i) => {
    disparador.addEventListener('click', () => {
      mostrarFoto(i);
      visor.showModal();
    });
  });

  visor.querySelector('.visor-prev')!.addEventListener('click', () => mostrarFoto(indiceActual - 1));
  visor.querySelector('.visor-sig')!.addEventListener('click', () => mostrarFoto(indiceActual + 1));
  visor.addEventListener('keydown', (evento) => {
    if (evento.key === 'ArrowLeft') mostrarFoto(indiceActual - 1);
    if (evento.key === 'ArrowRight') mostrarFoto(indiceActual + 1);
  });
</script>

<style>
  .heroe-desarrollo {
    position: relative;
    min-height: min(62vh, 560px);
    display: flex;
    align-items: flex-end;
    color: var(--blanco);
  }

  .heroe-fondo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .heroe-velo {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(23, 20, 16, 0.85) 0%, rgba(23, 20, 16, 0.25) 45%, rgba(23, 20, 16, 0.15) 100%);
  }

  .heroe-contenido {
    position: relative;
    padding-block: 1.5rem 2.5rem;
    width: 100%;
  }

  .miga {
    margin-bottom: 1.25rem;
  }

  .miga a {
    color: var(--blanco);
    text-decoration: none;
    font-family: var(--titulos);
    font-weight: 700;
    opacity: 0.9;
  }

  .miga a:hover {
    opacity: 1;
  }

  .heroe-datos {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .heroe-logo {
    width: 96px;
    height: 96px;
    object-fit: contain;
    background: var(--blanco);
    border-radius: var(--radio-chico);
    padding: 8px;
    flex-shrink: 0;
  }

  .heroe-desarrollo h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 0.1em;
  }

  .heroe-lugar {
    font-size: 1.1rem;
    opacity: 0.9;
    margin-bottom: 0.6rem;
  }

  .heroe-precio-fila {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.9rem;
  }

  .heroe-precio {
    font-family: var(--titulos);
    font-weight: 800;
    font-size: 1.35rem;
    color: var(--amarillo);
  }

  .seccion-compacta {
    padding-block: clamp(1.75rem, 4vw, 3rem);
  }

  .seccion-nota {
    color: var(--tinta-suave);
    margin-top: -0.5rem;
    margin-bottom: 1.25rem;
  }

  .descripcion {
    font-size: 1.15rem;
    max-width: 46rem;
    margin-bottom: 1.25rem;
  }

  /* Galería */
  .galeria {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  /* En móvil la galería es una tira horizontal con scroll-snap: compacta y
     deslizable con el pulgar, en lugar de una columna interminable. */
  @media (max-width: 720px) {
    .galeria {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 0.75rem;
      padding-bottom: 0.5rem;
    }

    .galeria .galeria-item {
      flex: 0 0 74%;
      scroll-snap-align: start;
    }
  }

  .galeria-item {
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    border-radius: var(--radio);
    overflow: hidden;
    transition: transform 0.15s ease;
  }

  .galeria-item:hover {
    transform: scale(1.02);
  }

  .galeria-item img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  /* Tour y mapa responsivos */
  .marco-tour :global(iframe) {
    aspect-ratio: 16 / 9;
    height: auto;
  }

  .marco-mapa :global(iframe) {
    aspect-ratio: 4 / 3;
    height: auto;
  }

  /* Tarjetas de modelos */
  .rejilla-modelos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .modelo-tarjeta {
    display: flex;
    flex-direction: column;
  }

  .modelo-foto img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .modelo-cuerpo {
    padding: 1.2rem 1.3rem 1.4rem;
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .modelo-cuerpo h3 {
    font-size: 1.3rem;
    margin: 0;
  }

  .modelo-precio {
    font-family: var(--titulos);
    font-weight: 800;
    color: var(--terracota);
    margin: 0;
  }

  .modelo-datos {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    padding: 0;
    margin: 0;
    color: var(--tinta-suave);
    font-size: 0.95rem;
  }

  .modelo-datos li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .modelo-abrir {
    margin-top: 0.5rem;
  }

  /* Ficha técnica */
  .ficha {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 0.75rem;
    margin: 0 0 1.25rem;
  }

  .ficha > div {
    background: var(--crema);
    border-radius: var(--radio-chico);
    padding: 0.7rem 0.9rem;
  }

  .ficha dt {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--tinta-suave);
  }

  .ficha dd {
    margin: 0;
    font-family: var(--titulos);
    font-weight: 800;
  }

  /* Planos */
  .planos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .planos figure {
    margin: 0;
    text-align: center;
  }

  .planos img {
    aspect-ratio: auto;
    object-fit: contain;
    background: var(--blanco);
  }

  .planos figcaption {
    font-family: var(--titulos);
    font-weight: 700;
    color: var(--tinta-suave);
    margin-top: 0.4rem;
  }

  .columnas-caracteristicas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }

  /* Ubicación + contacto */
  .ubicacion-contacto {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 2rem;
    align-items: start;
  }

  .contacto-panel {
    padding: 1.75rem;
    display: grid;
    gap: 0.9rem;
    position: sticky;
    top: 7rem;
  }

  .contacto-panel h2 {
    font-size: 1.35rem;
    margin: 0;
  }

  .contacto-panel p {
    color: var(--tinta-suave);
    margin: 0;
  }

  .contacto-panel .btn {
    justify-content: center;
  }

  .contacto-facebook {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    justify-content: center;
    font-size: 0.95rem;
  }

  /* Diálogos de modelo */
  .modal-modelo {
    width: min(860px, calc(100vw - 2rem));
    max-height: calc(100vh - 3rem);
    border: 0;
    border-radius: var(--radio);
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--blanco);
    color: var(--tinta);
  }

  .modal-modelo::backdrop {
    background: rgba(23, 20, 16, 0.65);
    backdrop-filter: blur(3px);
  }

  .modal-encabezado {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .modal-encabezado h3 {
    font-size: 1.6rem;
    margin: 0;
  }

  .modal-cerrar {
    background: var(--crema);
    border: 0;
    border-radius: 50%;
    width: 2.6rem;
    height: 2.6rem;
    display: grid;
    place-items: center;
    cursor: pointer;
    flex-shrink: 0;
  }

  .modal-galeria {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .modal-galeria img {
    aspect-ratio: 4 / 3;
  }

  .modal-modelo h4 {
    margin-top: 0.5rem;
  }

  .modal-modelo .btn {
    margin-top: 0.5rem;
  }

  /* Visor de pantalla completa */
  .visor {
