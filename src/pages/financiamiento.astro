---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { CELULAR_VENTAS, MENSAJE_FINANCIAMIENTO, enlaceWhatsApp } from '../lib/contacto';

const opciones = [
  {
    icono: 'house-heart-fill',
    titulo: 'Crédito Infonavit',
    texto:
      'Si cotizas en el IMSS, tus puntos Infonavit pueden convertirse en tu casa. Te ayudamos a revisar tu precalificación y te acompañamos en cada paso del trámite.',
  },
  {
    icono: 'bank2',
    titulo: 'Crédito bancario',
    texto:
      'Un crédito hipotecario con el banco de tu preferencia. Te orientamos para comparar opciones y armar un expediente que facilite la aprobación.',
  },
  {
    icono: 'cash-coin',
    titulo: 'Compra directa',
    texto:
      'Trato directo con nosotros, sin intermediarios: apartado sencillo y un plan de pagos claro, de persona a persona.',
  },
];

const pasos = [
  {
    titulo: 'Elige tu casa',
    texto: 'Explora nuestros desarrollos disponibles y encuentra la que se siente como tu hogar.',
  },
  {
    titulo: 'Platícanos por WhatsApp',
    texto: 'Nos cuentas tu situación y juntos encontramos el esquema de pago que mejor te conviene.',
  },
  {
    titulo: 'Arma tu expediente',
    texto: 'Te decimos exactamente qué documentos necesitas según tu tipo de crédito, sin vueltas de más.',
  },
  {
    titulo: 'Firma y estrena',
    texto: 'Te acompañamos hasta la firma y la entrega de llaves. Bienvenido a casa.',
  },
];

const preguntas = [
  {
    pregunta: '¿Puedo usar mi crédito Infonavit con ustedes?',
    respuesta:
      'Sí. Nuestras viviendas pueden adquirirse con crédito Infonavit. Si aún no conoces tu precalificación o tus puntos, escríbenos y te orientamos para consultarla.',
  },
  {
    pregunta: '¿Qué documentos necesito para empezar?',
    respuesta:
      'Para comenzar basta con tu identificación oficial (INE) y tu CURP. Según el tipo de crédito se suman comprobantes de ingresos y de domicilio; te damos la lista exacta para tu caso, sin papeleo innecesario.',
  },
  {
    pregunta: '¿Cuánto necesito de enganche?',
    respuesta:
      'Depende del esquema: con algunos créditos el enganche puede ser muy bajo, y en preventa manejamos apartados accesibles. Platícanos tu situación y te decimos números concretos para la casa que te interesa.',
  },
  {
    pregunta: '¿Puedo combinar mi crédito con el de mi pareja o familiar?',
    respuesta:
      'En muchos casos sí: existen esquemas para unir créditos entre cónyuges o familiares y alcanzar un monto mayor. Te ayudamos a revisar si aplica para ustedes.',
  },
  {
    pregunta: '¿Qué incluye el acompañamiento de UREPPSA?',
    respuesta:
      'Desde la primera visita hasta la entrega de llaves: te orientamos con el crédito, revisamos tu expediente, damos seguimiento al trámite y estamos disponibles por WhatsApp durante todo el proceso.',
  },
];

// Las mismas preguntas del acordeón, como datos estructurados: las hace
// elegibles para mostrarse desplegables directamente en los resultados de
// Google (una sola fuente: editar `preguntas` actualiza ambas).
const faqEstructurado = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: preguntas.map((p) => ({
    '@type': 'Question',
    name: p.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: p.respuesta },
  })),
};
---

<Base
  titulo="Financiamiento: Infonavit, crédito bancario o directo | UREPPSA"
  descripcion="Infonavit, crédito bancario o compra directa: te acompañamos paso a paso para estrenar tu casa UREPPSA."
  mensajeWhatsApp={MENSAJE_FINANCIAMIENTO}
  datosEstructurados={[faqEstructurado]}
>
  <!-- Encabezado -->
  <section class="portada">
    <div class="contenedor">
      <span class="etiqueta">Financiamiento</span>
      <h1>Tu casa, <em>a tu manera</em>.</h1>
      <p>
        Hay más de un camino para llegar a tu hogar. Conoce las opciones y déjanos
        acompañarte en el que mejor se acomode a tu vida.
      </p>
    </div>
  </section>

  <div class="contenedor">
    <!-- Opciones -->
    <section class="seccion seccion-compacta">
      <div class="rejilla-opciones">
        {opciones.map((o, i) => (
          <div class="tarjeta opcion revelar" style={`--retraso: ${i * 90}ms`}>
            <span class="opcion-icono"><Icono nombre={o.icono} tamano={24} /></span>
            <h2>{o.titulo}</h2>
            <p>{o.texto}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Proceso -->
    <section class="seccion seccion-compacta">
      <div class="seccion-encabezado revelar">
        <span class="etiqueta">Proceso</span>
        <h2>Así de simple es estrenar</h2>
        <p>Cuatro pasos, cero letras chiquitas.</p>
      </div>
      <ol class="pasos">
        {pasos.map((p, i) => (
          <li class="paso revelar" style={`--retraso: ${i * 110}ms`}>
            <span class="paso-numero">{i + 1}</span>
            <div>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- Preguntas frecuentes -->
    <section class="seccion seccion-compacta">
      <div class="seccion-encabezado revelar">
        <span class="etiqueta">Dudas</span>
        <h2>Preguntas frecuentes</h2>
        <p>Lo que más nos preguntan las familias antes de estrenar.</p>
      </div>
      <div class="preguntas">
        {preguntas.map((p, i) => (
          <details class="pregunta tarjeta revelar" style={`--retraso: ${i * 60}ms`}>
            <summary>
              {p.pregunta}
              <span class="pregunta-icono" aria-hidden="true"><Icono nombre="plus-lg" tamano={18} /></span>
            </summary>
            <p>{p.respuesta}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="seccion seccion-compacta">
      <div class="cta-final revelar">
        <h2>¿Hablamos de tu caso?</h2>
        <p>Cada familia es distinta. Escríbenos y te decimos, con números reales, cómo llegar a tu casa.</p>
        <a
          href={enlaceWhatsApp(CELULAR_VENTAS, MENSAJE_FINANCIAMIENTO)}
          class="btn btn-whatsapp"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icono nombre="whatsapp" /> Platícanos por WhatsApp
        </a>
      </div>
    </section>
  </div>
</Base>

<style>
  /* .portada y .seccion-compacta viven en global.css */

  .rejilla-opciones {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .opcion {
    padding: 1.75rem;
  }

  .opcion h2 {
    font-size: 1.2rem;
  }

  .opcion p {
    color: var(--tinta-suave);
    margin: 0;
  }

  .opcion-icono {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 14px;
    background: var(--verde-claro);
    color: var(--verde-oscuro);
    margin-bottom: 0.9rem;
  }

  /* Pasos */
  .pasos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    counter-reset: paso;
  }

  .paso {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .paso-numero {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--verde);
    color: #fff;
    font-family: var(--titulos);
    font-weight: 800;
    font-size: 1.15rem;
    flex-shrink: 0;
    box-shadow: 0 8px 18px rgba(47, 125, 59, 0.35);
  }

  .paso h3 {
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }

  .paso p {
    color: var(--tinta-suave);
    margin: 0;
    font-size: 0.98rem;
  }

  /* Preguntas */
  .preguntas {
    display: grid;
    gap: 0.9rem;
    max-width: 780px;
  }

  .pregunta {
    padding: 0;
    overflow: visible;
  }

  .pregunta summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    list-style: none;
    cursor: pointer;
    padding: 1.1rem 1.4rem;
    font-family: var(--titulos);
    font-weight: 800;
    font-size: 1.05rem;
  }

  .pregunta summary::-webkit-details-marker {
    display: none;
  }

  .pregunta-icono {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--verde-claro);
    color: var(--verde-oscuro);
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .pregunta[open] .pregunta-icono {
    transform: rotate(45deg);
  }

  .pregunta > p {
    padding: 0 1.4rem 1.25rem;
    margin: 0;
    color: var(--tinta-suave);
  }

  /* CTA final */
  .cta-final {
    text-align: center;
    background: var(--verde-oscuro);
    color: #fff;
    border-radius: var(--radio);
    padding: clamp(2rem, 5vw, 3.5rem);
  }

  .cta-final h2 {
    color: #fff;
  }

  .cta-final p {
    color: rgba(255, 255, 255, 0.85);
    max-width: 34rem;
    margin-inline: auto;
  }
</style>
