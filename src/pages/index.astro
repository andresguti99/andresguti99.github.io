---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import MapaMexico from '../components/MapaMexico.astro';
import TarjetaDesarrollo from '../components/TarjetaDesarrollo.astro';
import Icono from '../components/Icono.astro';
import { CELULAR_VENTAS, enlaceWhatsApp } from '../lib/contacto';

const ciudades = await getCollection('ciudades');
const nombreCiudad = (id: string) => ciudades.find((c) => c.id === id)?.data.nombre ?? id;

const desarrollos = (await getCollection('desarrollos')).sort((a, b) => b.data.anio - a.data.anio);
const testimonios = await getCollection('testimonios');

// Escaparate del héroe: primero los disponibles, después los más recientes.
const destacados = [...desarrollos]
  .sort((a, b) => Number(b.data.disponible) - Number(a.data.disponible) || b.data.anio - a.data.anio)
  .slice(0, 4);

const estadisticas = [
  { cifra: '30+', texto: 'años de experiencia' },
  { cifra: '5,000+', texto: 'casas entregadas' },
  { cifra: '20+', texto: 'municipios en México' },
];

const financiamiento = [
  {
    titulo: 'Crédito Infonavit',
    texto: 'Usa tus puntos Infonavit para estrenar casa. Te acompañamos en todo el trámite, sin letras chiquitas.',
  },
  {
    titulo: 'Crédito bancario',
    texto: 'Trabajamos con los principales bancos para que consigas la mejor tasa según tu perfil.',
  },
  {
    titulo: 'Compra directa',
    texto: 'Plan de pagos directo con nosotros, con apartado sencillo y trato de persona a persona.',
  },
];
---

<Base titulo="UREPPSA | Cada Vivienda, Un Compromiso">
  <!-- Héroe -->
  <section class="heroe">
    <div class="contenedor heroe-interno">
      <div class="heroe-texto">
        <span class="etiqueta">Desarrollos habitacionales</span>
        <h1>Cada vivienda, <em>un compromiso</em>.</h1>
        <p>
          Construimos fraccionamientos seguros y llenos de vida para familias mexicanas,
          con más de 30 años de experiencia y más de 5,000 hogares entregados.
        </p>
        <div class="heroe-acciones">
          <a href="#desarrollos" class="btn btn-primario">Explora nuestros desarrollos</a>
          <a
            href={enlaceWhatsApp(CELULAR_VENTAS, 'Hola, quiero informes de los desarrollos de UREPPSA')}
            class="btn btn-whatsapp"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icono nombre="whatsapp" /> Escríbenos
          </a>
        </div>
      </div>

      <!-- Escaparate: rota los proyectos disponibles y más recientes -->
      <div class="escaparate" data-escaparate>
        {destacados.map((d, i) => (
          <a
            class:list={['escaparate-lamina', { activa: i === 0 }]}
            href={`/desarrollos/${d.id}/`}
            aria-hidden={i === 0 ? 'false' : 'true'}
            tabindex={i === 0 ? 0 : -1}
          >
            <Image
              src={d.data.imagenes[0]}
              alt={`Fotografía de ${d.data.nombre}`}
              widths={[480, 720, 1040]}
              sizes="(max-width: 900px) 100vw, 50vw"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
            <div class="escaparate-velo"></div>
            {d.data.logo && (
              <Image class="escaparate-logo" src={d.data.logo} alt="" width={110} densities={[1, 2]} loading={i === 0 ? 'eager' : 'lazy'} />
            )}
            <div class="escaparate-panel">
              <span class={`pildora ${d.data.disponible ? 'pildora-disponible' : 'pildora-vendido'}`}>
                {d.data.disponible ? 'Disponible' : 'Vendido'}
              </span>
              <strong>{d.data.nombre}</strong>
              <span class="escaparate-detalle">{nombreCiudad(d.data.ciudad.id)} · {d.data.precio}</span>
            </div>
          </a>
        ))}
        <div class="escaparate-puntos" role="tablist" aria-label="Proyectos destacados">
          {destacados.map((d, i) => (
            <button
              class:list={[{ activo: i === 0 }]}
              data-indice={i}
              aria-label={`Mostrar ${d.data.nombre}`}
            ></button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Cifras -->
  <section class="cifras">
    <div class="contenedor cifras-interno">
      {estadisticas.map((e) => (
        <div class="cifra">
          <strong>{e.cifra}</strong>
          <span>{e.texto}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Mapa -->
  <section class="seccion" id="mapa">
    <div class="contenedor">
      <div class="seccion-encabezado">
        <span class="etiqueta">Presencia</span>
        <h2>¿Dónde construimos?</h2>
        <p>De la costa del Pacífico al Bajío: elige tu ciudad para ver sus desarrollos.</p>
      </div>
      <MapaMexico />
    </div>
  </section>

  <!-- Desarrollos -->
  <section class="seccion" id="desarrollos">
    <div class="contenedor">
      <div class="seccion-encabezado">
        <span class="etiqueta">Catálogo</span>
        <h2>Nuestros desarrollos</h2>
        <p>Del más reciente al más querido: cada uno cuenta la historia de cientos de familias.</p>
      </div>
      <div class="filtros" role="group" aria-label="Filtrar por ciudad">
        <button class="chip activo" data-ciudad="todas">Todas las ciudades</button>
        {ciudades
          .sort((a, b) => a.data.nombre.localeCompare(b.data.nombre))
          .map((c) => (
            <button class="chip" data-ciudad={c.id}>{c.data.nombre}</button>
          ))}
      </div>
      <div class="rejilla-desarrollos">
        {desarrollos.map((d) => (
          <TarjetaDesarrollo desarrollo={d} nombreCiudad={nombreCiudad(d.data.ciudad.id)} />
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonios -->
  <section class="seccion" id="testimonios">
    <div class="contenedor">
      <div class="seccion-encabezado">
        <span class="etiqueta">Testimonios</span>
        <h2>Familias que ya están en casa</h2>
        <p>Reseñas reales de Google y Facebook.</p>
      </div>
      <div class="rejilla-testimonios">
        {testimonios.map((t) => (
          <figure class="tarjeta testimonio">
            <div class="estrellas" aria-label={`${t.data.estrellas} de 5 estrellas`}>
              {Array.from({ length: t.data.estrellas }).map(() => <Icono nombre="star-fill" tamano={16} />)}
            </div>
            <blockquote>{t.data.texto}</blockquote>
            <figcaption>
              <strong>{t.data.autor}</strong>
              <span>
                {t.data.proyecto}
                {t.data.enlace && (
                  <>
                    {' · '}
                    <a href={t.data.enlace} target="_blank" rel="noopener noreferrer">ver reseña</a>
                  </>
                )}
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Financiamiento -->
  <section class="seccion" id="financiamiento">
    <div class="contenedor">
      <div class="seccion-encabezado">
        <span class="etiqueta">Financiamiento</span>
        <h2>Tu casa, a tu manera</h2>
        <p>Hay más de un camino para llegar a tu hogar. Te ayudamos a encontrar el tuyo.</p>
      </div>
      <div class="rejilla-financiamiento">
        {financiamiento.map((f) => (
          <div class="tarjeta opcion-financiamiento">
            <h3>{f.titulo}</h3>
            <p>{f.texto}</p>
          </div>
        ))}
      </div>
      <div class="financiamiento-cta">
        <a
          href={enlaceWhatsApp(CELULAR_VENTAS, 'Hola, quiero saber qué opciones de financiamiento tengo para una casa UREPPSA')}
          class="btn btn-whatsapp"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icono nombre="whatsapp" /> Pregunta por tu crédito
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  // ── Escaparate del héroe ─────────────────────────────────────────────
  const escaparate = document.querySelector('[data-escaparate]');
  if (escaparate) {
    const laminas = [...escaparate.querySelectorAll<HTMLElement>('.escaparate-lamina')];
    const puntos = [...escaparate.querySelectorAll<HTMLButtonElement>('.escaparate-puntos button')];
    let actual = 0;
    let temporizador: ReturnType<typeof setInterval>;

    const mostrar = (indice: number) => {
      actual = (indice + laminas.length) % laminas.length;
      laminas.forEach((lamina, i) => {
        const activa = i === actual;
        lamina.classList.toggle('activa', activa);
        lamina.setAttribute('aria-hidden', String(!activa));
        lamina.tabIndex = activa ? 0 : -1;
      });
      puntos.forEach((punto, i) => punto.classList.toggle('activo', i === actual));
    };

    const iniciar = () => (temporizador = setInterval(() => mostrar(actual + 1), 5000));
    const detener = () => clearInterval(temporizador);

    puntos.forEach((punto) =>
      punto.addEventListener('click', () => {
        detener();
        mostrar(Number(punto.dataset.indice));
        iniciar();
      })
    );
    escaparate.addEventListener('mouseenter', detener);
    escaparate.addEventListener('mouseleave', iniciar);
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) iniciar();
  }

  // ── Filtro de desarrollos por ciudad ─────────────────────────────────
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.filtros .chip')];
  const tarjetas = [...document.querySelectorAll<HTMLElement>('[data-ciudad-tarjeta]')];

  const filtrar = (ciudad: string) => {
    chips.forEach((chip) => chip.classList.toggle('activo', chip.dataset.ciudad === ciudad));
    tarjetas.forEach((tarjeta) => {
      tarjeta.hidden = ciudad !== 'todas' && tarjeta.dataset.ciudadTarjeta !== ciudad;
    });
  };

  chips.forEach((chip) => chip.addEventListener('click', () => filtrar(chip.dataset.ciudad!)));
  window.addEventListener('filtrar-ciudad', (evento) => filtrar((evento as CustomEvent<string>).detail));
</script>

<style>
  /* Héroe */
  .heroe {
    padding-block: clamp(2.5rem, 6vw, 5rem);
    background:
      radial-gradient(60% 80% at 85% 20%, var(--verde-claro) 0%, transparent 70%),
      radial-gradient(50% 70% at 10% 90%, var(--terracota-claro) 0%, transparent 70%);
  }

  .heroe-interno {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .heroe h1 {
    font-size: clamp(2.3rem, 5.5vw, 3.6rem);
  }

  .heroe h1 em {
    font-style: normal;
    color: var(--verde);
  }

  .heroe-texto p {
    font-size: 1.2rem;
    color: var(--tinta-suave);
    max-width: 34rem;
  }

  .heroe-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.6rem;
  }

  /* Escaparate */
  .escaparate {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 32px 120px 32px 32px;
    overflow: hidden;
    box-shadow: var(--sombra-alta);
  }

  .escaparate-lamina {
    position: absolute;
    inset: 0;
    display: block;
    text-decoration: none;
    color: #fff;
    opacity: 0;
    transition: opacity 0.7s ease;
    pointer-events: none;
  }

  .escaparate-lamina.activa {
    opacity: 1;
    pointer-events: auto;
  }

  .escaparate-lamina > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .escaparate-velo {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(23, 20, 16, 0.8) 0%, transparent 55%);
  }

  .escaparate-logo {
    position: absolute;
    top: 1.1rem;
    left: 1.1rem;
    width: clamp(70px, 8vw, 110px);
    height: auto;
    background: rgba(255, 255, 255, 0.94);
    border-radius: var(--radio-chico);
    padding: 8px;
    opacity: 0;
    transform: scale(0.6);
  }

  .escaparate-lamina.activa .escaparate-logo {
    animation: aparecerLogo 0.6s 0.25s ease both;
  }

  .escaparate-panel {
    position: absolute;
    left: 1.25rem;
    right: 1.25rem;
    bottom: 1.25rem;
    display: grid;
    gap: 0.3rem;
    justify-items: start;
    opacity: 0;
    transform: translateY(24px);
  }

  .escaparate-lamina.activa .escaparate-panel {
    animation: subirPanel 0.65s 0.15s ease both;
  }

  .escaparate-panel strong {
    font-family: var(--titulos);
    font-weight: 800;
    font-size: clamp(1.3rem, 2.6vw, 1.9rem);
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.45);
  }

  .escaparate-detalle {
    font-family: var(--titulos);
    font-weight: 700;
    color: var(--amarillo);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }

  .escaparate-puntos {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    display: flex;
    gap: 0.45rem;
    z-index: 2;
  }

  .escaparate-puntos button {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.5);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .escaparate-puntos button.activo {
    background: #fff;
    transform: scale(1.25);
  }

  @keyframes aparecerLogo {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes subirPanel {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Cifras */
  .cifras {
    background: var(--verde-oscuro);
    color: var(--blanco);
    padding-block: 1.75rem;
  }

  .cifras-interno {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    text-align: center;
  }

  .cifra strong {
    display: block;
    font-family: var(--titulos);
    font-weight: 800;
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    color: var(--amarillo);
  }

  .cifra span {
    font-size: 0.95rem;
    opacity: 0.9;
  }

  /* Filtros */
  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
  }

  .chip {
    font-family: var(--titulos);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--tinta);
    background: var(--blanco);
    border: 2px solid rgba(43, 38, 32, 0.12);
    border-radius: 999px;
    padding: 0.45rem 1.1rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .chip:hover {
    border-color: var(--verde);
  }

  .chip.activo {
    background: var(--verde);
    border-color: var(--verde);
    color: #fff;
  }

  /* Rejillas */
  .rejilla-desarrollos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .rejilla-testimonios {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .testimonio {
    margin: 0;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
  }

  .estrellas {
    display: flex;
    gap: 0.25rem;
    color: var(--amarillo);
    margin-bottom: 0.8rem;
  }

  .testimonio blockquote {
    margin: 0 0 1rem;
    color: var(--tinta-suave);
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .testimonio figcaption strong {
    display: block;
    font-family: var(--titulos);
  }

  .testimonio figcaption span {
    font-size: 0.9rem;
    color: var(--tinta-suave);
  }

  .rejilla-financiamiento {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .opcion-financiamiento {
    padding: 1.6rem;
    border-top: 5px solid var(--verde);
  }

  .opcion-financiamiento h3 {
    font-size: 1.15rem;
  }

  .opcion-financiamiento p {
    color: var(--tinta-suave);
    margin: 0;
  }

  .financiamiento-cta {
    margin-top: 2rem;
    text-align: center;
  }

  @media (max-width: 900px) {
    .heroe-interno {
      grid-template-columns: 1fr;
    }
    .cifras-interno {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }
</style>
