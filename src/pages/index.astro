---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import MapaMexico from '../components/MapaMexico.astro';
import TarjetaDesarrollo from '../components/TarjetaDesarrollo.astro';
import Icono from '../components/Icono.astro';
import { CELULAR_VENTAS, MENSAJE_INFORMES, MENSAJE_FINANCIAMIENTO, enlaceWhatsApp } from '../lib/contacto';
import { ESTADISTICAS, ANIOS_EXPERIENCIA, MUNICIPIOS, CASAS_TEXTO } from '../lib/empresa';

const ciudades = await getCollection('ciudades');
const nombreCiudad = (id: string) => ciudades.find((c) => c.id === id)?.data.nombre ?? id;

// "Celaya - Gto.": ciudad con estado abreviado, para espacios compactos.
const ABREVIATURAS_ESTADO: Record<string, string> = {
  Michoacán: 'Mich.',
  Guanajuato: 'Gto.',
  Guerrero: 'Gro.',
};
const ciudadCorta = (id: string) => {
  const c = ciudades.find((x) => x.id === id);
  if (!c) return id;
  const abrev = c.data.estado ? (ABREVIATURAS_ESTADO[c.data.estado] ?? c.data.estado) : '';
  return abrev ? `${c.data.nombre} - ${abrev}` : c.data.nombre;
};

const desarrollos = (await getCollection('desarrollos')).sort((a, b) => b.data.anio - a.data.anio);
const testimonios = await getCollection('testimonios');

// Escaparate del héroe: los proyectos disponibles hoy; si algún día no
// hubiera ninguno, muestra los más recientes para no dejar el héroe vacío.
const disponibles = desarrollos.filter((d) => d.data.disponible);
const destacados = disponibles.length > 0 ? disponibles : desarrollos.slice(0, 3);

// Logos para la marquesina de trayectoria.
const conLogo = desarrollos.filter((d) => d.data.logo);

// Imagen para la tarjeta al compartir el sitio en redes.
const imagenSocial = destacados.length
  ? (await getImage({ src: destacados[0].data.imagenes[0], width: 1200 })).src
  : undefined;

const estadisticas = ESTADISTICAS;

const financiamiento = [
  {
    icono: 'house-heart-fill',
    titulo: 'Crédito Infonavit',
    texto: 'Usa tus puntos Infonavit para estrenar casa. Te acompañamos en todo el trámite, sin letras chiquitas.',
  },
  {
    icono: 'bank2',
    titulo: 'Crédito bancario',
    texto: 'Trabajamos con los principales bancos para que consigas la mejor tasa según tu perfil.',
  },
  {
    icono: 'cash-coin',
    titulo: 'Compra de contado',
    texto: 'Apartado sencillo y trato de persona a persona, siempre directamente con nosotros.',
  },
  {
    icono: 'piggy-bank-fill',
    titulo: 'Otros créditos',
    texto: '¿Fovissste, caja popular u otro esquema? Escríbenos y te orientamos sin costo.',
  },
];
---

<Base
  titulo="UREPPSA | Casas nuevas en venta en Michoacán y Guanajuato"
  descripcion={`Casas nuevas en venta en Lázaro Cárdenas y Celaya, y más de ${ANIOS_EXPERIENCIA} años construyendo fraccionamientos en México. Crédito Infonavit, Fovissste o bancario. Cada vivienda, un compromiso.`}
  imagenSocial={imagenSocial}
>
  <!-- Héroe -->
  <section class="heroe">
    <div class="contenedor heroe-interno">
      <div class="heroe-texto">
        <span class="etiqueta">Desarrollos habitacionales</span>
        <h1>Cada vivienda, <em>un compromiso</em>.</h1>
        <p>
          Construimos fraccionamientos seguros y llenos de vida, con casas nuevas en venta en
          Michoacán y Guanajuato: más de {ANIOS_EXPERIENCIA} años de experiencia y más de
          {CASAS_TEXTO} hogares entregados a familias mexicanas.
        </p>
        <div class="heroe-acciones">
          <a href="#desarrollos" class="btn btn-primario">Explora nuestros desarrollos</a>
          <a
            href={enlaceWhatsApp(CELULAR_VENTAS, MENSAJE_INFORMES)}
            class="btn btn-whatsapp"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icono nombre="whatsapp" /> Escríbenos
          </a>
        </div>
      </div>

      <!-- Escaparate: solo los proyectos disponibles hoy -->
      <div class="escaparate" data-escaparate>
        {destacados.map((d, i) => (
          <a
            class:list={['escaparate-lamina', { activa: i === 0 }]}
            href={`/desarrollos/${d.id}/`}
            aria-hidden={i === 0 ? 'false' : 'true'}
            tabindex={i === 0 ? 0 : -1}
          >
            <Image
              src={d.data.imagenes[0]}
              alt={`Fotografía de ${d.data.nombre}`}
              widths={[480, 720, 1040]}
              sizes="(max-width: 900px) 100vw, 50vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
            />
            <div class="escaparate-barra">
              {d.data.logo && (
                <Image
                  class="escaparate-barra-logo"
                  src={d.data.logo}
                  alt=""
                  width={52}
                  densities={[1, 2]}
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              )}
              <div class="escaparate-info">
                <strong>{d.data.nombre}</strong>
                <span class="escaparate-lugar">{ciudadCorta(d.data.ciudad.id)}</span>
                <span>{d.data.precio}</span>
              </div>
              <span class={`pildora ${d.data.disponible ? 'pildora-disponible' : 'pildora-vendido'}`}>
                {d.data.disponible ? 'Disponible' : 'Vendido'}
              </span>
            </div>
          </a>
        ))}
        {destacados.length > 1 && (
          <div class="escaparate-puntos" role="tablist" aria-label="Proyectos disponibles">
            {destacados.map((d, i) => (
              <button class:list={[{ activo: i === 0 }]} data-indice={i} aria-label={`Mostrar ${d.data.nombre}`}></button>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Cifras -->
  <section class="cifras">
    <div class="contenedor cifras-interno">
      {estadisticas.map((e) => (
        <div class="cifra">
          <strong data-contar={e.valor}>0+</strong>
          <span>{e.texto}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Marquesina de trayectoria -->
  <section class="marquesina" aria-label={`Nuestros fraccionamientos a lo largo de ${ANIOS_EXPERIENCIA} años`}>
    <p class="marquesina-titulo">Tres décadas de fraccionamientos que ya son hogar</p>
    <div class="marquesina-vista">
      <div class="marquesina-pista">
        {[...conLogo, ...conLogo].map((d) => (
          <a href={`/desarrollos/${d.id}/`} title={d.data.nombre}>
            <Image src={d.data.logo!} alt={d.data.nombre} width={96} densities={[1, 2]} loading="lazy" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Mapa -->
  <section class="seccion" id="mapa">
    <div class="contenedor">
      <div class="seccion-encabezado revelar">
        <span class="etiqueta">Presencia</span>
        <h2>¿Dónde construimos?</h2>
        <p>
          Más de {MUNICIPIOS} municipios nos han visto construir; estas son nuestras localidades
          más relevantes. Elige tu ciudad para ver sus desarrollos.
        </p>
      </div>
      <div class="revelar" style="--retraso: 120ms">
        <MapaMexico />
      </div>
    </div>
  </section>

  <!-- Desarrollos -->
  <section class="seccion" id="desarrollos">
    <div class="contenedor">
      <div class="seccion-encabezado revelar">
        <span class="etiqueta">Catálogo</span>
        <h2>Algunos de nuestros desarrollos</h2>
        <p>
          Una muestra de nuestra trayectoria, del más reciente al más querido: cada uno cuenta la
          historia de cientos de familias.
        </p>
      </div>
      <div class="filtros revelar" role="group" aria-label="Filtrar por ciudad" style="--retraso: 80ms">
        <button class="chip activo" data-ciudad="todas">Todas las ciudades</button>
        {ciudades
          .sort((a, b) => a.data.nombre.localeCompare(b.data.nombre))
          .map((c) => (
            <button class="chip" data-ciudad={c.id}>{c.data.nombre}</button>
          ))}
      </div>
      <div class="rejilla-desarrollos">
        {desarrollos.map((d, i) => (
          <div class="revelar" style={`--retraso: ${(i % 3) * 90}ms`}>
            <TarjetaDesarrollo desarrollo={d} nombreCiudad={nombreCiudad(d.data.ciudad.id)} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonios -->
  <section class="seccion" id="testimonios">
    <div class="contenedor">
      <div class="seccion-encabezado revelar">
        <span class="etiqueta">Testimonios</span>
        <h2>Familias que ya están en casa</h2>
        <p>Reseñas reales de Google y Facebook.</p>
      </div>
      <div class="rejilla-testimonios">
        {testimonios.map((t, i) => (
          <figure class="tarjeta testimonio revelar" style={`--retraso: ${i * 90}ms`}>
            <div class="estrellas" aria-label={`${t.data.estrellas} de 5 estrellas`}>
              {Array.from({ length: t.data.estrellas }).map(() => <Icono nombre="star-fill" tamano={16} />)}
            </div>
            <blockquote>{t.data.texto}</blockquote>
            <figcaption>
              <strong>{t.data.autor}</strong>
              <span>
                {t.data.proyecto}
                {t.data.enlace && (
                  <>
                    {' · '}
                    <a href={t.data.enlace} target="_blank" rel="noopener noreferrer">ver reseña</a>
                  </>
                )}
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Financiamiento -->
  <section class="seccion" id="financiamiento">
    <div class="contenedor">
      <div class="seccion-encabezado revelar">
        <span class="etiqueta">Financiamiento</span>
        <h2>Tu casa, a tu manera</h2>
        <p>Hay más de un camino para llegar a tu hogar. Te ayudamos a encontrar el tuyo.</p>
      </div>
      <div class="rejilla-financiamiento">
        {financiamiento.map((f, i) => (
          <div class="tarjeta opcion-financiamiento revelar" style={`--retraso: ${i * 90}ms`}>
            <span class="opcion-icono"><Icono nombre={f.icono} tamano={24} /></span>
            <h3>{f.titulo}</h3>
            <p>{f.texto}</p>
          </div>
        ))}
      </div>
      <div class="financiamiento-cta revelar">
        <a href="/financiamiento/" class="btn btn-primario">Conoce el proceso completo</a>
        <a
          href={enlaceWhatsApp(CELULAR_VENTAS, MENSAJE_FINANCIAMIENTO)}
          class="btn btn-whatsapp"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icono nombre="whatsapp" /> Pregunta por tu crédito
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  // ── Escaparate del héroe ─────────────────────────────────────────────
  const escaparate = document.querySelector('[data-escaparate]');
  if (escaparate) {
    const laminas = [...escaparate.querySelectorAll<HTMLElement>('.escaparate-lamina')];
    const puntos = [...escaparate.querySelectorAll<HTMLButtonElement>('.escaparate-puntos button')];
    let actual = 0;
    let temporizador: ReturnType<typeof setInterval> | undefined;

    const mostrar = (indice: number) => {
      actual = (indice + laminas.length) % laminas.length;
      laminas.forEach((lamina, i) => {
        const activa = i === actual;
        lamina.classList.toggle('activa', activa);
        lamina.setAttribute('aria-hidden', String(!activa));
        lamina.tabIndex = activa ? 0 : -1;
      });
      puntos.forEach((punto, i) => punto.classList.toggle('activo', i === actual));
    };

    const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');
    const detener = () => clearInterval(temporizador);
    const iniciar = () => {
      detener(); // nunca dos intervalos a la vez
      if (laminas.length > 1 && !sinMovimiento.matches) {
        temporizador = setInterval(() => mostrar(actual + 1), 5000);
      }
    };

    puntos.forEach((punto) =>
      punto.addEventListener('click', () => {
        detener();
        mostrar(Number(punto.dataset.indice));
        iniciar();
      })
    );
    escaparate.addEventListener('mouseenter', detener);
    escaparate.addEventListener('mouseleave', iniciar);
    iniciar();
  }

  // ── Cifras que cuentan hacia arriba ──────────────────────────────────
  const formato = new Intl.NumberFormat('es-MX');
  const animarCifra = (el: HTMLElement) => {
    const objetivo = Number(el.dataset.contar);
    const duracion = 1100;
    const inicio = performance.now();
    const paso = (ahora: number) => {
      const progreso = Math.min((ahora - inicio) / duracion, 1);
      const suavizado = 1 - Math.pow(1 - progreso, 3);
      el.textContent = `${formato.format(Math.round(objetivo * suavizado))}+`;
      if (progreso < 1) requestAnimationFrame(paso);
    };
    requestAnimationFrame(paso);
  };

  const observadorCifras = new IntersectionObserver(
    (entradas) => {
      entradas.forEach((entrada) => {
        if (entrada.isIntersecting) {
          animarCifra(entrada.target as HTMLElement);
          observadorCifras.unobserve(entrada.target);
        }
      });
    },
    { threshold: 0.6 }
  );
  document.querySelectorAll<HTMLElement>('[data-contar]').forEach((el) => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      el.textContent = `${formato.format(Number(el.dataset.contar))}+`;
    } else {
      observadorCifras.observe(el);
    }
  });

  // ── Filtro de desarrollos por ciudad ─────────────────────────────────
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.filtros .chip')];
  const tarjetas = [...document.querySelectorAll<HTMLElement>('[data-ciudad-tarjeta]')];

  const filtrar = (ciudad: string) => {
    chips.forEach((chip) => chip.classList.toggle('activo', chip.dataset.ciudad === ciudad));
    tarjetas.forEach((tarjeta) => {
      // La tarjeta vive dentro de un envoltorio .revelar: ocultamos el envoltorio
      const envoltorio = tarjeta.closest<HTMLElement>('.revelar') ?? tarjeta;
      envoltorio.hidden = ciudad !== 'todas' && tarjeta.dataset.ciudadTarjeta !== ciudad;
    });
  };

  chips.forEach((chip) => chip.addEventListener('click', () => filtrar(chip.dataset.ciudad!)));
  window.addEventListener('filtrar-ciudad', (evento) => filtrar((evento as CustomEvent<string>).detail));

  // Enlaces antiguos tipo desarrollos.html?city=X llegan como /?ciudad=x#desarrollos
  const ciudadInicial = new URLSearchParams(location.search).get('ciudad');
  if (ciudadInicial && chips.some((chip) => chip.dataset.ciudad === ciudadInicial)) {
    filtrar(ciudadInicial);
  }
</script>

<style>
  /* Héroe */
  .heroe {
    position: relative;
    padding-block: clamp(2.5rem, 6vw, 5.5rem);
    background:
      radial-gradient(60% 80% at 85% 20%, var(--verde-claro) 0%, transparent 70%),
      radial-gradient(50% 70% at 10% 90%, var(--terracota-claro) 0%, transparent 70%);
  }

  /* Retícula de puntos, sello de las páginas modernas */
  .heroe::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--puntos) 1.2px, transparent 1.2px);
    background-size: 24px 24px;
    mask-image: radial-gradient(65% 70% at 35% 40%, black, transparent);
    pointer-events: none;
  }

  .heroe-interno {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .heroe h1 {
    font-size: clamp(2.3rem, 5.5vw, 3.7rem);
  }

  .heroe h1 em {
    font-style: normal;
    background: linear-gradient(90deg, var(--verde), #6cb26f 45%, var(--terracota));
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: flujoGradiente 7s ease-in-out infinite alternate;
  }

  @keyframes flujoGradiente {
    from {
      background-position: 0% 0;
    }
    to {
      background-position: 100% 0;
    }
  }

  .heroe-texto p {
    font-size: 1.2rem;
    color: var(--tinta-suave);
    max-width: 34rem;
  }

  .heroe-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.6rem;
  }

  /* Escaparate */
  .escaparate {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 28px;
    overflow: hidden;
    box-shadow: var(--sombra-alta);
    border: 1px solid rgba(43, 38, 32, 0.1);
  }

  .escaparate-lamina {
    position: absolute;
    inset: 0;
    display: block;
    text-decoration: none;
    color: #fff;
    opacity: 0;
    transition: opacity 0.7s ease;
    pointer-events: none;
  }

  .escaparate-lamina.activa {
    opacity: 1;
    pointer-events: auto;
  }

  .escaparate-lamina > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .escaparate-barra {
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.85rem 1.1rem;
    border-radius: 18px;
    background: rgba(21, 18, 14, 0.55);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    opacity: 0;
    transform: translateY(20px);
  }

  .escaparate-lamina.activa .escaparate-barra {
    animation: subirBarra 0.6s 0.15s ease both;
  }

  @keyframes subirBarra {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .escaparate-barra-logo {
    width: 46px;
    height: 46px;
    object-fit: contain;
    flex-shrink: 0;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(6px);
    padding: 4px;
    border: 1px solid rgba(255, 255, 255, 0.35);
  }

  .escaparate-info {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .escaparate-info strong {
    font-family: var(--titulos);
    font-weight: 800;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* La ciudad discreta arriba; el precio en amarillo debajo */
  .escaparate-info .escaparate-lugar {
    color: rgba(255, 255, 255, 0.88);
    font-family: var(--texto);
    font-weight: 600;
    font-size: 0.85rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .escaparate-info span {
    font-size: 0.92rem;
    color: var(--amarillo);
    font-family: var(--titulos);
    font-weight: 700;
  }

  .escaparate-barra .pildora {
    flex-shrink: 0;
  }

  .escaparate-puntos {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: flex;
    gap: 0.4rem;
    padding: 0.4rem 0.55rem;
    border-radius: 999px;
    background: rgba(21, 18, 14, 0.4);
    backdrop-filter: blur(8px);
    z-index: 2;
  }

  .escaparate-puntos button {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.45);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .escaparate-puntos button.activo {
    background: #fff;
    transform: scale(1.2);
  }

  /* Cifras */
  .cifras {
    background: var(--verde-oscuro);
    color: var(--blanco);
    padding-block: 1.75rem;
  }

  .cifras-interno {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    text-align: center;
  }

  .cifra strong {
    display: block;
    font-family: var(--titulos);
    font-weight: 800;
    font-size: clamp(1.7rem, 4vw, 2.4rem);
    color: var(--amarillo);
    font-variant-numeric: tabular-nums;
  }

  .cifra span {
    font-size: 0.95rem;
    opacity: 0.9;
  }

  /* Marquesina */
  .marquesina {
    padding-block: 1.75rem 0.5rem;
  }

  .marquesina-titulo {
    text-align: center;
    font-family: var(--titulos);
    font-weight: 700;
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tinta-suave);
    margin-bottom: 1rem;
  }

  .marquesina-vista {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 12%, black 88%, transparent);
  }

  .marquesina-pista {
    display: flex;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 4.5rem);
    width: max-content;
    animation: desplazar 35s linear infinite;
  }

  .marquesina-vista:hover .marquesina-pista {
    animation-play-state: paused;
  }

  .marquesina-pista img {
    height: 56px;
    width: auto;
    object-fit: contain;
    opacity: 0.75;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .marquesina-pista a:hover img {
    opacity: 1;
    transform: scale(1.08);
  }

  @keyframes desplazar {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquesina-pista {
      animation: none;
    }
    .heroe h1 em {
      animation: none;
    }
  }

  /* Filtros */
  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 1.75rem;
  }

  .chip {
    font-family: var(--titulos);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--tinta);
    background: var(--blanco);
    border: 2px solid rgba(43, 38, 32, 0.12);
    border-radius: 999px;
    padding: 0.45rem 1.1rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .chip:hover {
    border-color: var(--verde);
  }

  .chip.activo {
    background: var(--verde);
    border-color: var(--verde);
