---
import '@fontsource-variable/nunito';
import '@fontsource-variable/figtree';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFlotante from '../components/WhatsAppFlotante.astro';

interface Props {
  titulo: string;
  descripcion?: string;
  /** Mensaje prellenado del botón flotante de WhatsApp. */
  mensajeWhatsApp?: string;
}

const {
  titulo,
  descripcion = 'Descubre tu hogar ideal con UREPPSA. Más de 20 municipios. Más de 30 años de experiencia. Más de 5,000 casas entregadas.',
  mensajeWhatsApp,
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppFlotante mensaje={mensajeWhatsApp} />
    <script>
      // Revelado suave de secciones al entrar al viewport
      const observador = new IntersectionObserver(
        (entradas) => {
          entradas.forEach((entrada) => {
            if (entrada.isIntersecting) {
              entrada.target.classList.add('visible');
              observador.unobserve(entrada.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      document.querySelectorAll('.revelar').forEach((el) => observador.observe(el));
    </script>
  </body>
</html>
